{
  "name": "@link-foundation/sensitive-data-sanitizer",
  "version": "2.1.0",
  "description": "Offline sensitive-text sanitization with credential, multilingual personal-data and scanner union detection",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "sensitive-data-sanitizer": "./bin/sensitive-data-sanitizer.js",
    "sensitive-data-sanitizer-legacy": "./bin/legacy-example-package-name.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/API.md",
    "docs/COVERAGE.md",
    "docs/HISTORY-REMEDIATION.md",
    "examples/combined-scanners.mjs",
    "examples/presidio-bridge.py",
    "examples/sanitize-session.mjs",
    "examples/realistic-fakes.mjs",
    "examples/stream-jsonl.mjs",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "examples/shared-tool-logs.mjs",
    "examples/reversible-placeholders.mjs",
    "examples/prose-logs.mjs",
    "docs/RULES.md",
    "examples/custom-log-policy.mjs",
    "examples/second-pass-placeholders.mjs",
    "docs/README.md",
    "docs/USE-CASES.md",
    "docs/VERIFICATION.md",
    "docs/LIVE-REPLIES.md",
    "examples/live-reply-adapter.mjs",
    "examples/local-model-spans.mjs",
    "examples/verify-credential.mjs",
    "examples/known-names-in-code.mjs"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./credentials": {
      "types": "./src/credentials-entry.d.ts",
      "import": "./src/credentials-entry.js",
      "require": "./src/credentials-entry.js",
      "default": "./src/credentials-entry.js"
    },
    "./eslint-plugin": {
      "types": "./src/eslint-plugin.d.ts",
      "import": "./src/eslint-plugin.js"
    },
    "./legacy": {
      "types": "./src/legacy.d.ts",
      "browser": "./src/arithmetic.js",
      "import": "./src/legacy.js"
    },
    "./ner": {
      "types": "./src/ner.d.ts",
      "import": "./src/ner.js"
    }
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 tests/*.test.js",
    "lint": "node scripts/lint.mjs",
    "lint:all": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd .",
    "check:secrets": "secretlint \"**/*\" && node scripts/check-secrets.mjs",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "example:web:dev": "npm --prefix examples/universal-app run dev",
    "example:web:build": "npm --prefix examples/universal-app run build",
    "example:web:preview": "npm --prefix examples/universal-app run preview",
    "example:web:preview-images": "node scripts/update-preview-images.mjs",
    "example:desktop:package": "npm --prefix examples/universal-app run desktop:package",
    "example:desktop:make": "npm --prefix examples/universal-app run desktop:make",
    "example:mobile:sync": "npm --prefix examples/universal-app run mobile:sync",
    "prepare": "node scripts/install-git-hooks.mjs",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main"
  },
  "keywords": [
    "sanitization",
    "redaction",
    "secrets",
    "pii",
    "privacy",
    "logs",
    "cli"
  ],
  "author": "",
  "license": "Unlicense",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.3",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/sensitive-data-sanitizer.git"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@nlpjs/ner": "4.27.0",
    "browser-commander": "0.35.0",
    "cmd-shim": "^9.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "lint-staged": "^17.6.1",
    "mrz": "^5.0.2",
    "playwright": "1.65.1",
    "prettier": "^3.10.1",
    "secretlint": "14.0.1",
    "semver": "^7.8.6",
    "test-anywhere": "^0.9.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ],
    "*.sh": [
      "pipx run --no-path-check --spec shellcheck-py==0.11.0.1 shellcheck"
    ],
    "*.py": [
      "pipx run --spec ruff==0.17.6 ruff check --fix --force-exclude",
      "pipx run --spec ruff==0.17.6 ruff format --force-exclude",
      "pipx run --spec ruff==0.17.6 ruff format --check --force-exclude"
    ],
    ".husky/*": [
      "pipx run --no-path-check --spec shellcheck-py==0.11.0.1 shellcheck"
    ]
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@secretlint/core": "14.0.1",
    "@secretlint/profiler": "14.0.1",
    "command-stream": "3.0.0",
    "libphonenumber-js": "1.13.17",
    "links-notation": "0.31.8",
    "lino-arguments": "0.4.1",
    "lino-i18n": "0.6.0",
    "lino-objects-codec": "1.0.0",
    "re2-wasm": "1.0.2",
    "re2js": "^2.10.0",
    "tar-stream": "3.2.2",
    "yaml": "^2.9.1",
    "yauzl": "3.4.0"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "node-pty": false
  },
  "overrides": {
    "minimatch@>=7 <11": "^11.0.9"
  },
  "peerDependencies": {
    "@nlpjs/ner": "^4.27.0"
  },
  "peerDependenciesMeta": {
    "@nlpjs/ner": {
      "optional": true
    }
  }
}
