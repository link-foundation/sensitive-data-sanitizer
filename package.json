{
  "name": "@link-foundation/sensitive-data-sanitizer",
  "version": "0.18.0",
  "description": "Offline sensitive-text sanitization with credential, multilingual personal-data and scanner union detection",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "sensitive-data-sanitizer": "./bin/sensitive-data-sanitizer.js",
    "sensitive-data-sanitizer-legacy": "./bin/legacy-example-package-name.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/API.md",
    "docs/COVERAGE.md",
    "docs/HISTORY-REMEDIATION.md",
    "examples/combined-scanners.mjs",
    "examples/presidio-bridge.py",
    "examples/sanitize-session.mjs",
    "examples/realistic-fakes.mjs",
    "examples/stream-jsonl.mjs",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "examples/shared-tool-logs.mjs",
    "examples/reversible-placeholders.mjs",
    "examples/prose-logs.mjs"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./eslint-plugin": {
      "types": "./src/eslint-plugin.d.ts",
      "import": "./src/eslint-plugin.js"
    },
    "./legacy": {
      "types": "./src/legacy.d.ts",
      "browser": "./src/arithmetic.js",
      "import": "./src/legacy.js"
    }
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 tests/*.test.js",
    "lint": "node scripts/lint.mjs",
    "lint:all": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd .",
    "check:secrets": "secretlint \"**/*\"",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "example:web:dev": "npm --prefix examples/universal-app run dev",
    "example:web:build": "npm --prefix examples/universal-app run build",
    "example:web:preview": "npm --prefix examples/universal-app run preview",
    "example:web:preview-images": "node scripts/update-preview-images.mjs",
    "example:desktop:package": "npm --prefix examples/universal-app run desktop:package",
    "example:desktop:make": "npm --prefix examples/universal-app run desktop:make",
    "example:mobile:sync": "npm --prefix examples/universal-app run mobile:sync",
    "prepare": "node scripts/install-git-hooks.mjs",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main"
  },
  "keywords": [
    "sanitization",
    "redaction",
    "secrets",
    "pii",
    "privacy",
    "logs",
    "cli"
  ],
  "author": "",
  "license": "Unlicense",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.2",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/sensitive-data-sanitizer.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "browser-commander": "0.34.1",
    "cmd-shim": "^9.0.2",
    "command-stream": "2.6.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "lino-arguments": "0.4.0",
    "lint-staged": "^17.6.0",
    "mrz": "^5.0.2",
    "playwright": "1.65.0",
    "prettier": "^3.9.10",
    "secretlint": "13.1.0",
    "semver": "^7.8.6",
    "test-anywhere": "^0.9.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ],
    "*.sh": [
      "pipx run --spec shellcheck-py==0.11.0.1 shellcheck"
    ],
    "*.py": [
      "pipx run --spec ruff==0.17.4 ruff check --fix --force-exclude",
      "pipx run --spec ruff==0.17.4 ruff format --force-exclude",
      "pipx run --spec ruff==0.17.4 ruff format --check --force-exclude"
    ],
    ".husky/*": [
      "pipx run --spec shellcheck-py==0.11.0.1 shellcheck"
    ]
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@secretlint/core": "13.1.0",
    "@secretlint/profiler": "13.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "libphonenumber-js": "1.13.15",
    "links-notation": "0.31.0",
    "re2-wasm": "1.0.2",
    "re2js": "^2.9.1",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "node-pty": false
  },
  "overrides": {
    "minimatch@>=7 <11": "^11.0.5"
  }
}
