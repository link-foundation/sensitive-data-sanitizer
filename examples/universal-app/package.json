{
  "name": "universal-example-app",
  "version": "0.1.0",
  "private": true,
  "description": "Universal React example for the JavaScript template package",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:start": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --dir",
    "desktop:make": "npm run build && electron-builder",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android:add": "cap add android",
    "mobile:android:open": "cap open android",
    "mobile:android:run": "npm run build && cap sync android && cap run android",
    "mobile:android:build": "npm run build && cap sync android && cap build android",
    "mobile:ios:add": "cap add ios",
    "mobile:ios:open": "cap open ios",
    "mobile:ios:run": "npm run build && cap sync ios && cap run ios",
    "mobile:ios:build": "npm run build && cap sync ios && cap build ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "foundation.link.template.example",
    "productName": "Universal Example App",
    "asar": true,
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "maintainer": "Template Maintainers"
    },
    "mac": {
      "target": "zip"
    },
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "global-agent": "^4.1.6",
    "@electron/asar": "4.3.1",
    "temp": {
      "rimraf": "file:../../compat/temp-rimraf"
    },
    "electron-winstaller": "5.4.4",
    "minimatch@>=7 <11": "^11.0.5",
    "glob@>=9 <=14.0.2": "^14.0.3"
  },
  "author": "Link Foundation"
}
