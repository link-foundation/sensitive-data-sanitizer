    - 'tests/container-jobs.test.js'\n      - '.github/workflows/example-app.yml'\n      - '.github/actions/artifact-transport/**'\n      - 'scripts/artifact-transport.mjs'\n      - 'scripts/artifact-files.mjs'\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\n# Provide Git config to actions/checkout itself; checkout runs git init before\n# any workflow step can configure Git.\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  web-build:\n    name: Build web app\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-web-build\n      cancel-in-progress: true\n    # check-pages.sh and configure-pages read the Pages API, which answers\n    # a request it does not authorise with the same 404 as a disabled site,\n    # so the read is granted explicitly.\n    permissions:\n      contents: read\n      pages: read\n    # The deploy job publishes exactly the artifact this run uploaded.\n    outputs:\n      pages-artifact-id: ${{ steps.pages-artifact.outputs.artifact-id }}\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n          cache: npm\n          cache-dependency-path: examples/universal-app/package-lock.json\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      # Pull requests never deploy, so they only warn; main fails with the\n      # setting a maintainer has to change.\n      - name: Check GitHub Pages source\n        env:\n          GH_TOKEN: ${{ github.token }}\n          REPOSITORY: ${{ github.repository }}\n          PAGES_MODE: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' && 'require' || 'warn' }}\n        run: bash scripts/check-pages.sh\n\n      - name: Configure GitHub Pages\n        if: github.event_name == 'push' && github.ref == 'refs/heads/main'\n        uses: actions/configure-pages@v6.0.0\n\n      - name: Install app dependencies\n        run: npm ci --prefix examples/universal-app --no-audit --no-fund\n\n      - name: Build app\n        run: npm run example:web:build\n        env:\n          GITHUB_PAGES: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}\n          VITE_REPOSITORY_URL: https://github.com/${{ github.repository }}\n\n      - name: Upload web build artifact\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: universal-example-web\n          path: examples/universal-app/dist\n          if-no-files-found: error\n\n      - name: Upload GitHub Pages artifact\n        id: pages-artifact\n        if: github.event_name == 'push' && github.ref == 'refs/heads/main'\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: github-pages\n          pages: 'true'\n          path: examples/universal-app/dist\n\n  # Requires Settings → Pages → Source = GitHub Actions to be set once\n  # in the repository before this job can succeed. See README → \"Deploying\n  # the example app\". The Pages source cannot be configured from a workflow.\n  pages-deploy:\n    name: Deploy GitHub Pages\n    needs: [web-build]\n    if: github.event_name == 'push' && github.ref == 'refs/heads/main'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: main-writer-${{ github.repository }}-main\n      cancel-in-progress: false\n      queue: max\n    permissions:\n      # Read the deployment script; deployment itself needs only pages and\n      # OIDC.\n      contents: read\n      pages: write\n      id-token: write\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      # The REST protocol of actions/deploy-pages@v5, which sends one\n      # creation request and fails the job on a single transient HTTP 500.\n      # The script retries 429/5xx/network failures of that request, adopts a\n      # deployment whose response was lost so one commit is never deployed\n      # twice, fails permanent 4xx at once and cancels what it abandons.\n      - name: Deploy Pages artifact\n        id: deployment\n        env:\n          GITHUB_TOKEN: ${{ github.token }}\n          ARTIFACT_ID: ${{ needs.web-build.outputs.pages-artifact-id }}\n        run: node --throw-deprecation scripts/deploy-pages.mjs\n\n  desktop-package:\n    name: Package desktop app (${{ matrix.os }})\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 20\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-desktop-package-${{ matrix.os }}\n      cancel-in-progress: true\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-24.04, macos-26-intel, windows-2025]\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n          cache: npm\n          cache-dependency-path: examples/universal-app/package-lock.json\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Install app dependencies\n        run: npm ci --prefix examples/universal-app --no-audit --no-fund\n\n      - name: Verify desktop compatibility APIs\n        run: node --pending-deprecation --throw-deprecation scripts/check-desktop-compat.mjs\n\n      - name: Package Electron app\n        shell: bash\n        run: |\n          npm run example:desktop:package\n          for attempt in {1..30}; do\n            echo \"Waiting for the packaged app (attempt ${attempt}/30)\"\n            if [[ -d examples/universal-app/out ]] &&\n              [[ -n \"$(find examples/universal-app/out -mindepth 1 -print -quit)\" ]]; then\n              find examples/universal-app/out -maxdepth 2 -mindepth 1 -print\n              exit 0\n            fi\n            sleep 1\n          done\n          echo \"::error::Desktop package output was not created at examples/universal-app/out\"\n          exit 1\n        env:\n          VITE_REPOSITORY_URL: https://github.com/${{ github.repository }}\n\n      - name: Upload desktop package\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: universal-example-desktop-${{ matrix.os }}\n          path: examples/universal-app/out\n          if-no-files-found: error\n\n  android-build:\n    name: Build Android app\n    if: github.event_name == 'workflow_dispatch' && vars.EXAMPLE_APP_ENABLE_ANDROID_BUILD == 'true'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 30\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-android-build\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n          cache: npm\n          cache-dependency-path: examples/universal-app/package-lock.json\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Setup Java\n        uses: actions/setup-java@v6.2.0\n        with:\n          distribution: temurin\n          java-version: '21.0.13+9'\n\n      - name: Setup Android SDK\n        uses: android-actions/setup-android@be39fa834029ff78f1a44aa3bb0819b8fc2bd8fd # v4.0.4\n\n      - name: Install app dependencies\n        run: npm ci --prefix examples/universal-app --no-audit --no-fund\n\n      - name: Add Android project\n        run: npm --prefix examples/universal-app run mobile:android:add\n\n      - name: Build Android project\n        run: npm --prefix examples/universal-app run mobile:android:build\n\n      - name: Upload Android output\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: universal-example-android\n          path: |\n            examples/universal-app/android/app/build/outputs/**/*.apk\n            examples/universal-app/android/app/build/outputs/**/*.aab\n          if-no-files-found: error\n\n  ios-build:\n    name: Build iOS app\n    if: github.event_name == 'workflow_dispatch' && vars.EXAMPLE_APP_ENABLE_IOS_BUILD == 'true'\n    runs-on: macos-26-intel\n    timeout-minutes: 30\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-ios-build\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n          cache: npm\n          cache-dependency-path: examples/universal-app/package-lock.json\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Install app dependencies\n        run: npm ci --prefix examples/universal-app --no-audit --no-fund\n\n      - name: Add iOS project\n        run: npm --prefix examples/universal-app run mobile:ios:add\n\n      - name: Build iOS project\n        run: npm --prefix examples/universal-app run mobile:ios:build\n\n  # Exercise the same publishing environment on PRs, where the writer is skipped.\n  preview-tools:\n    name: Verify preview container tools\n    runs-on: ubuntu-24.04\n    container:\n      image: mcr.microsoft.com/playwright@sha256:6e3fb709361521eb27161606e6da6d2674e5e89fa16516cb37d6fdd91372273d # v1.65.0-noble\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-preview-tools\n      cancel-in-progress: true\n    defaults:\n      run:\n        shell: bash\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n      - name: Trust the checkout\n        run: git config --global --add safe.directory \"$GITHUB_WORKSPACE\"\n      - uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Install pinned GitHub CLI\n        run: bash scripts/setup-preview-gh.sh\n      - name: Verify publishing tools without repository writes\n        run: bash scripts/check-preview-tools.sh\n\n  # Regenerate example-app preview screenshots (docs/screenshots/example-app/*)\n  # using browser-commander + Playwright so README/site images always reflect\n  # the current UI. Issue: #62. Implementation: scripts/update-preview-images.mjs.\n  preview-regen:\n    name: Regenerate Preview Images\n    needs: [preview-tools]\n    runs-on: ubuntu-24.04\n    container:\n      # Keep this release in sync with the playwright package version below.\n      # Pinned by digest (a mutable tag is arbitrary code execution in a job\n      # that holds contents: write). Re-resolve when bumping:\n      #   docker buildx imagetools inspect mcr.microsoft.com/playwright:<tag>\n      image: mcr.microsoft.com/playwright@sha256:6e3fb709361521eb27161606e6da6d2674e5e89fa16516cb37d6fdd91372273d # v1.65.0-noble\n    timeout-minutes: 20\n    concurrency:\n      group: main-writer-${{ github.repository }}-main\n      cancel-in-progress: false\n      queue: max\n    if: |\n      (github.event_name == 'push' && github.ref == 'refs/heads/main') ||\n      github.event_name == 'workflow_dispatch'\n    permissions:\n      contents: write\n    env:\n      PLAYWRIGHT_BROWSERS_PATH: /ms-playwright\n    # Container jobs run `run:` blocks with sh, which has no [[ ]].\n    defaults:\n      run:\n        shell: bash\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          # Regenerate against main HEAD so the bot commit lands on a\n          # fast-forward parent regardless of which trigger started the job.\n          ref: main\n          token: ${{ secrets.GITHUB_TOKEN }}\n          fetch-depth: 0\n          persist-credentials: false\n\n      # The container user (root) does not own the runner's workspace, so git\n      # refuses the checkout as dubious ownership until it is trusted.\n      - name: Trust the checkout\n        run: git config --global --add safe.directory \"$GITHUB_WORKSPACE\"\n\n      - uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Install pinned GitHub CLI\n        run: bash scripts/setup-preview-gh.sh\n\n      - name: Verify publishing tools without repository writes\n        run: bash scripts/check-preview-tools.sh\n\n      - name: Install example app dependencies\n        run: npm ci --prefix examples/universal-app --no-audit --no-fund\n\n      # Preview tools and their transitive dependencies share the reviewed root lock.\n      - name: Install browser automation dependencies\n        env:\n          PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD: '1'\n        run: npm ci --no-audit --no-fund\n\n      - name: Regenerate preview images\n        id: regenerate\n        run: node scripts/update-preview-images.mjs\n\n      - name: Detect drift\n        id: drift\n        run: |\n          # The assignment fails the step when git fails; a test on $(...)\n          # would read the failure as no drift.\n          changes=\"$(git status --porcelain)\"\n          if [[ -n \"$changes\" ]]; then\n            echo \"drift=true\" >> \"$GITHUB_OUTPUT\"\n            echo \"Preview images drifted:\"\n            printf '%s\\n' \"$changes\"\n          else\n            echo \"drift=false\" >> \"$GITHUB_OUTPUT\"\n            echo \"Preview images already current.\"\n          fi\n\n      - name: Commit drift back to main\n        id: commit\n        if: steps.drift.outputs.drift == 'true'\n        env:\n          # The dedicated actor lets required pull_request checks run when a\n          # ruleset sends this generated commit through the fallback PR. A\n          # main without such a ruleset takes a direct push with the job's own\n          # token, so the secret is optional until a ruleset is added.\n          RELEASE_PR_TOKEN: ${{ secrets.RELEASE_PR_TOKEN }}\n          BUILT_IN_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          SECRETS_URL: ${{ github.server_url }}/${{ github.repository }}/settings/secrets/actions\n        run: |\n          export GH_TOKEN=\"${RELEASE_PR_TOKEN:-$BUILT_IN_TOKEN}\"\n          # Configure gh as a step-scoped Git credential helper. The checkout\n          # remains credential-free during dependency installation.\n          gh auth setup-git\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n          # Stage only generated artifacts so unrelated changes can't leak in.\n          git add -- docs/screenshots/example-app/\n          if git diff --cached --quiet; then\n            echo \"::notice::No tracked preview-image changes to commit (drift was outside expected paths).\"\n            git status --porcelain\n            exit 0\n          fi\n          # Screenshot-only pushes do not match this workflow's path filter.\n          # Do not add [skip ci]: a fallback PR needs its required checks.\n          git commit -m \"chore(preview): regenerate example-app preview images\"\n          if [[ -n \"$RELEASE_PR_TOKEN\" ]]; then\n            node scripts/push-main-with-rebase-retry.mjs origin main --label preview-images\n            echo \"landed=true\" >> \"$GITHUB_OUTPUT\"\n            exit 0\n          fi\n          echo \"RELEASE_PR_TOKEN is not set: pushing with the built-in GITHUB_TOKEN.\"\n          if ! node scripts/push-main-with-rebase-retry.mjs origin main --label preview-images; then\n            echo \"::error title=Preview images need RELEASE_PR_TOKEN::The preview images changed, but main refused a push with the built-in GITHUB_TOKEN (a ruleset requires a pull request, and pull requests opened by that token do not run checks). Add a fine-grained token with Contents and Pull requests read/write access as the RELEASE_PR_TOKEN secret at $SECRETS_URL and re-run this job, or run 'npm run example:web:preview-images' locally and commit docs/screenshots/example-app/*.png.\"\n            exit 1\n          fi\n          echo \"landed=true\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Upload screenshot failure artifacts\n        if: failure()\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: preview-regen-failure-${{ github.run_id }}\n          path: docs/screenshots/example-app/\n          retention-days: 7\n          if-no-files-found: error\n\n      # One outcome, one message: report what actually happened instead of\n      # claiming a commit that a failed step never made.\n      - name: Summarize regeneration result\n        if: always()\n        env:\n          REGENERATE: ${{ steps.regenerate.outcome }}\n          DRIFT: ${{ steps.drift.outputs.drift }}\n          DRIFT_OUTCOME: ${{ steps.drift.outcome }}\n          COMMIT: ${{ steps.commit.outcome }}\n          LANDED: ${{ steps.commit.outputs.landed }}\n        run: |\n          if [[ \"$REGENERATE\" != \"success\" ]]; then\n            echo \"Preview images were not regenerated (step outcome: ${REGENERATE:-not run}).\"\n          elif [[ \"$DRIFT_OUTCOME\" != \"success\" ]]; then\n            echo \"Preview drift could not be checked (step outcome: ${DRIFT_OUTCOME:-not run}).\"\n          elif [[ \"$DRIFT\" == \"false\" ]]; then\n            echo \"::notice::Preview images are already up to date.\"\n          elif [[ \"$COMMIT\" == \"success\" && \"$LANDED\" == \"true\" ]]; then\n            echo \"::notice::Regenerated preview images were committed to main.\"\n          else\n            echo \"Regenerated preview images differ but were not committed (commit outcome: ${COMMIT:-not run}).\"\n          fi\n\n  # Terminal status gate: runs even when the jobs above fail or are\n  # cancelled, and turns a `timeout-minutes` kill (reported as cancelled)\n  # into a red run. needs is derived and checked by the status-gate-coverage\n  # job in workflows.yml.\n  pipeline-status:\n    name: Pipeline Status\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-pipeline-status\n      cancel-in-progress: true\n    # A status function is required: without one the gate inherits the\n    # implicit \"every dependency succeeded\" condition and is skipped in\n    # exactly the runs it exists to report.\n    if: >-\n      !cancelled()\n    needs:\n      - web-build\n      - pages-deploy\n      - desktop-package\n      - android-build\n      - ios-build\n      - preview-tools\n      - preview-regen\n    # actions: read lets the gate list this run's jobs and name the ones\n    # GitHub never acquired a runner for.\n    permissions:\n      actions: read\n      contents: read\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Fail the run when a required job was cancelled or failed\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          GH_TOKEN: ${{ github.token }}\n          RUN_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n          HEAD_REF: ${{ github.event_name == 'pull_request' && format('refs/pull/{0}/head', github.event.number) || github.ref }}\n        run: bash scripts/check-pipeline-status.sh\n"
