previous head of the\n      # branch already passed this workflow, so a docs-only push can trust\n      # its incremental range.\n      actions: read\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-detect-changes\n      cancel-in-progress: true\n    if: github.event_name != 'workflow_dispatch'\n    outputs:\n      js-changed: ${{ steps.changes.outputs.js-changed }}\n      docs-changed: ${{ steps.changes.outputs.docs-changed }}\n      any-code-changed: ${{ steps.changes.outputs.any-code-changed }}\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Detect changes\n        id: changes\n        env:\n          GITHUB_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          GITHUB_BEFORE_SHA: ${{ github.event.before }}\n          GITHUB_AFTER_SHA: ${{ github.event.after }}\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          GITHUB_WORKFLOW_REF: ${{ github.workflow_ref }}\n        run: node scripts/detect-code-changes.mjs\n\n  # === FAST CHECKS - run before slow tests for fastest feedback ===\n  # See: hive-mind CI/CD best practices principle #5 (fast-fail job ordering)\n\n  # Syntax check all .mjs files with node --check (~7s)\n  test-compilation:\n    name: Test Compilation\n    runs-on: ubuntu-24.04\n    # Typical run: <10s. Tight cap fails fast on syntax-check hangs.\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-test-compilation\n      cancel-in-progress: true\n    needs: [detect-changes]\n    if: |\n      !cancelled() &&\n      (needs.detect-changes.outputs.js-changed == 'true' || github.event_name == 'workflow_dispatch')\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Check JavaScript syntax\n        run: bash scripts/check-mjs-syntax.sh\n\n  # Enforce 1500-line limit on .mjs files and release.yml\n  check-file-line-limits:\n    name: Check File Line Limits\n    runs-on: ubuntu-24.04\n    # Typical run: <10s. This job only walks tracked files and counts lines.\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-check-file-line-limits\n      cancel-in-progress: true\n    needs: [detect-changes]\n    if: |\n      !cancelled() &&\n      (needs.detect-changes.outputs.docs-changed == 'true' ||\n       needs.detect-changes.outputs.any-code-changed == 'true' || github.event_name == 'workflow_dispatch')\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Simulate fresh merge with base branch (PR only)\n        if: github.event_name == 'pull_request'\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        run: bash scripts/simulate-fresh-merge.sh\n\n      # Enforces the 1500-line limit on JavaScript (.js/.mjs/.cjs) and\n      # Markdown (.md) files plus release.yml. This is the single source\n      # of truth for the line limit; validate-docs no longer re-checks it.\n      - name: Check file line limits\n        run: bash scripts/check-file-line-limits.sh\n\n  session-publication:\n    name: Session Publication Corpus\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-session-publication\n      cancel-in-progress: true\n    needs: [detect-changes]\n    if: |\n      !cancelled() &&\n      (needs.detect-changes.outputs.any-code-changed == 'true' ||\n       (github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'instant'))\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - name: Simulate fresh merge with base branch (PR only)\n        if: github.event_name == 'pull_request'\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        run: bash scripts/simulate-fresh-merge.sh\n      - uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n      - name: Install corpus dependencies\n        run: npm ci\n      - name: Publish Codex and Claude session corpus with zero residuals\n        run: bash scripts/run-with-budget-warning.sh 120 \"Session publication corpus\" node --max-old-space-size=512 experiments/issue-34/session-corpus.mjs\n\n  # === VERSION CHANGE CHECK ===\n  # Prohibit manual version changes in package.json - versions should only be changed by CI/CD\n  version-check:\n    name: Check for Manual Version Changes\n    runs-on: ubuntu-24.04\n    # Typical run: ~6s. Read-only package.json diff inspection.\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-version-check\n      cancel-in-progress: true\n    if: github.event_name == 'pull_request'\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Check for version changes in package.json\n        env:\n          GITHUB_HEAD_REF: ${{ github.head_ref }}\n          PR_AUTHOR: ${{ github.event.pull_request.user.login }}\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n          GITHUB_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          GITHUB_HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n          RELEASE_PR_ACTOR: ${{ vars.RELEASE_PR_ACTOR }}\n        run: node scripts/check-version.mjs\n\n  # === CHANGESET CHECK - only runs on PRs with code changes ===\n  # Docs-only PRs (./docs folder, markdown files) don't require changesets\n  changeset-check:\n    name: Check for Changesets\n    runs-on: ubuntu-24.04\n    # Typical run: <30s including dependency installation. 10min covers cold runners.\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-changeset-check\n      cancel-in-progress: true\n    needs: [detect-changes]\n    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.any-code-changed == 'true'\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Check for changesets\n        env:\n          # Pass PR context to the validation script\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n          GITHUB_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          GITHUB_HEAD_REF: ${{ github.head_ref }}\n          PR_AUTHOR: ${{ github.event.pull_request.user.login }}\n          GITHUB_HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n          RELEASE_PR_ACTOR: ${{ vars.RELEASE_PR_ACTOR }}\n        run: |\n          # Run changeset validation script\n          # This validates that exactly ONE changeset was ADDED by this PR\n          # Pre-existing changesets from other merged PRs are ignored\n          node scripts/validate-changeset.mjs\n\n  # === LINT AND FORMAT CHECK ===\n  # Lint runs independently of changeset-check - it's a fast check that should always run\n  # See: https://github.com/link-assistant/hive-mind/pull/1024 for why this dependency was removed\n  # IMPORTANT: ESLint includes max-lines rule (1500 lines) to ensure files stay maintainable\n  # See docs/case-studies/issue-23 for why fresh merge simulation is critical\n  lint:\n    name: Lint and Format Check\n    runs-on: ubuntu-24.04\n    # Typical run: <1min including install, ESLint, Prettier, jscpd,\n    # and secretlint. 10min protects against a hung lint plugin.\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-lint\n      cancel-in-progress: true\n    needs: [detect-changes]\n    if: |\n      !cancelled() &&\n      (\n        github.event_name == 'workflow_dispatch' ||\n        needs.detect-changes.outputs.docs-changed == 'true' ||\n        needs.detect-changes.outputs.any-code-changed == 'true'\n      )\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          # For PRs, fetch enough history to merge with base branch\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Simulate fresh merge with base branch (PR only)\n        if: github.event_name == 'pull_request'\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        run: bash scripts/simulate-fresh-merge.sh\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Check for secrets\n        run: npx --yes -p secretlint@13.0.7 -p @secretlint/secretlint-rule-preset-recommend@13.0.7 secretlint \"**/*\"\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Dry-run release versioning (PR only)\n        if: github.event_name == 'pull_request'\n        env:\n          npm_config_offline: 'true'\n          npm_config_ignore_scripts: 'true'\n        run: |\n          trap 'git restore --source=HEAD --staged --worktree -- .' EXIT\n          npm run changeset:version\n          git status --short\n\n      - name: Run ESLint\n        env:\n          LINT_ALL_WARNINGS: '1'\n        run: npm run lint:all -- --max-warnings 0\n\n      - name: Check formatting\n        run: npm run format:check\n\n      - name: Check code duplication\n        run: npm run check:duplication\n\n  # Test matrix: 3 runtimes (Node.js, Bun, Deno) x 3 OS (Ubuntu, macOS, Windows)\n  # IMPORTANT: Tests must validate the ACTUAL merge result, not a stale merge preview.\n  # See docs/case-studies/issue-23 for why this is critical.\n  # Fast-fail: slow test matrix only runs after fast checks pass (hive-mind principle #5)\n  test:\n    name: Test runtimes\n    env:\n      TEST_SHARD: ${{ matrix.shard }}\n    runs-on: ${{ matrix.os }}\n    # Typical run: <1min per runtime/OS on warm runners, with Windows\n    # sometimes slower on cold starts. Each test step owns an explicit\n    # budget below (see scripts/run-with-budget-warning.sh); this cap is\n    # only the backstop behind those budgets, sized so the budgets always\n    # expire first. A job killed by timeout-minutes reports *cancelled*,\n    # which hides the failure -- see docs/legacy/CI-TIMEOUT-BUDGETS.md.\n    timeout-minutes: 15\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-test-${{ matrix.runtime }}-${{ matrix.os }}-${{ matrix.shard }}\n      cancel-in-progress: true\n    needs:\n      [\n        detect-changes,\n        changeset-check,\n        test-compilation,\n        lint,\n        check-file-line-limits,\n      ]\n    # Use !cancelled() instead of always() so cancellation propagates correctly (hive-mind issue #1278)\n    # Run for relevant code/package/workflow changes, or for an instant manual\n    # release. Skipped fast checks count as non-failures only after one of\n    # those positive gates passes.\n    if: |\n      !cancelled() &&\n      (\n        needs.detect-changes.outputs.any-code-changed == 'true' ||\n        (\n          github.event_name == 'workflow_dispatch' &&\n          github.event.inputs.release_mode == 'instant'\n        )\n      ) &&\n      (needs.changeset-check.result == 'success' || needs.changeset-check.result == 'skipped') &&\n      (needs.test-compilation.result == 'success' || needs.test-compilation.result == 'skipped') &&\n      (needs.lint.result == 'success' || needs.lint.result == 'skipped') &&\n      (needs.check-file-line-limits.result == 'success' || needs.check-file-line-limits.result == 'skipped')\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-24.04, windows-2025]\n        runtime: [node, bun, deno]\n        shard: ['1/1']\n        exclude:\n          - { os: windows-2025, runtime: bun, shard: '1/1' }\n          - { os: windows-2025, runtime: deno, shard: '1/1' }\n        # Intel runners avoid ARM64 capacity failures. Partition the suite so\n        # each job retains its existing execution budget on the slower pool.\n        # Windows Bun runs subprocess fixtures serially and Deno initializes\n        # a separate worker graph per file. Partition both within their budgets.\n        include:\n          - { os: windows-2025, runtime: bun, shard: '1/3' }\n          - { os: windows-2025, runtime: bun, shard: '2/3' }\n          - { os: windows-2025, runtime: bun, shard: '3/3' }\n          - { os: windows-2025, runtime: deno, shard: '1/3' }\n          - { os: windows-2025, runtime: deno, shard: '2/3' }\n          - { os: windows-2025, runtime: deno, shard: '3/3' }\n          - { os: macos-26-intel, runtime: node, shard: '1/3' }\n          - { os: macos-26-intel, runtime: node, shard: '2/3' }\n          - { os: macos-26-intel, runtime: node, shard: '3/3' }\n          - { os: macos-26-intel, runtime: bun, shard: '1/3' }\n          - { os: macos-26-intel, runtime: bun, shard: '2/3' }\n          - { os: macos-26-intel, runtime: bun, shard: '3/3' }\n          # Six stripes separate the measured subprocess, timer and JSONL\n          # workloads; four stripes still warned on cold macOS Deno runners.\n          - { os: macos-26-intel, runtime: deno, shard: '1/6' }\n          - { os: macos-26-intel, runtime: deno, shard: '2/6' }\n          - { os: macos-26-intel, runtime: deno, shard: '3/6' }\n          - { os: macos-26-intel, runtime: deno, shard: '4/6' }\n          - { os: macos-26-intel, runtime: deno, shard: '5/6' }\n          - { os: macos-26-intel, runtime: deno, shard: '6/6' }\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          # For PRs, fetch enough history to merge with base branch\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Simulate fresh merge with base branch (PR only)\n        if: github.event_name == 'pull_request'\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        shell: bash\n        run: bash scripts/simulate-fresh-merge.sh\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Install dependencies (Node.js)\n        run: npm ci\n\n      - name: Run tests (Node.js)\n        if: matrix.runtime == 'node'\n        shell: bash\n        run: bash scripts/run-with-budget-warning.sh 300 \"Node.js test suite\" node scripts/run-test-shard.mjs node \"$TEST_SHARD\"\n\n      - name: Verify clone-only history rewrite with git-filter-repo\n        if: matrix.runtime == 'node' && matrix.os == 'ubuntu-24.04'\n        shell: bash\n        run: |\n          python3 -m venv \"$RUNNER_TEMP/history-tools\"\n          bash scripts/run-with-budget-warning.sh 120 \"Install history rewrite tool\" \"$RUNNER_TEMP/history-tools/bin/pip\" install git-filter-repo==2.47.0\n          GIT_FILTER_REPO=\"$RUNNER_TEMP/history-tools/bin/git-filter-repo\" bash scripts/run-with-budget-warning.sh 60 \"History rewrite integration\" node --max-old-space-size=512 experiments/history-rewrite-integration.mjs\n\n      - name: Setup Bun\n        if: matrix.runtime == 'bun'\n        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0\n        with:\n          bun-version: '1.4.4'\n\n      - name: Run tests (Bun)\n        if: matrix.runtime == 'bun'\n        shell: bash\n        # --timeout caps an *individual* test at 30s, matching Node's\n        # --test-timeout budget while leaving headroom for cold runners.\n        # It is a per-test bound and does not bound the suite: 25 tests of\n        # 29s each pass every per-test check. The suite budget below is\n        # what bounds the whole run.\n        run: bash scripts/run-with-budget-warning.sh 200 \"Bun test suite\" node scripts/run-test-shard.mjs bun \"$TEST_SHARD\"\n\n      - name: Setup Deno\n        if: matrix.runtime == 'deno'\n        uses: denoland/setup-deno@22d081ff2d3a40755e97629de92e3bcbfa7cf2ed # v2.0.5\n        with:\n          deno-version: v2.9.8\n\n      - name: Prepare Deno dependencies\n        if: matrix.runtime == 'deno'\n        shell: bash\n        # Cold npm downloads previously consumed the test execution budget.\n        # Bound dependency preparation separately, as for Node and Bun installs.\n        run: deno test -A --parallel --no-run --frozen\n\n      - name: Run tests (Deno)\n        if: matrix.runtime == 'deno'\n        shell: bash\n        run: bash scripts/run-with-budget-warning.sh 100 \"Deno test suite\" node scripts/run-test-shard.mjs deno \"$TEST_SHARD\"\n\n  # === DOCKER IMAGE BUILD CHECK (pull requests) ===\n  # Builds the Dockerfile without pushing so a broken image fails the pull\n  # request instead of surfacing only after publish (issue #106).\n  # push: false + load: true keeps this working for fork pull requests,\n  # which have no registry credentials. Skipped when no Dockerfile exists.\n  docker-build:\n    name: Docker Image Build Check\n    runs-on: ubuntu-24.04\n    # Typical run: a few minutes with a warm GHA layer cache. 30min covers\n    # a cold, uncached build without allowing a 6h hang.\n    timeout-minutes: 30\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-docker-build\n      cancel-in-progress: true\n    needs: [detect-changes]\n    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.any-code-changed == 'true'\n    permissions:\n      contents: read\n    env:\n      DOCKER_CONTEXT: ${{ vars.DOCKER_CONTEXT }}\n      DOCKERFILE: ${{ vars.DOCKERFILE }}\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Check Docker build configuration\n        id: docker_config\n        run: node scripts/check-docker-build.mjs\n\n      - name: Set up Docker Buildx (resilient)\n        if: steps.docker_config.outputs.enabled == 'true'\n        uses: ./.github/actions/setup-buildx-resilient\n\n      - name: Build Docker image (no push)\n        if: steps.docker_config.outputs.enabled == 'true'\n        # A `uses:` step cannot be wrapped by run-with-budget-warning.sh, so\n        # it declares its deadline with a step-level timeout-minutes: an\n        # exhausted step budget fails the step, while an exhausted job cap\n        # only cancels the job.\n        timeout-minutes: 20\n        uses: docker/build-push-action@v7.4.0\n        with:\n          context: ${{ steps.docker_config.outputs.context }}\n          file: ${{ steps.docker_config.outputs.dockerfile }}\n          push: false\n          load: true\n          tags: pr-check:${{ github.sha }}\n          # Scoped so this build cannot overwrite or be overwritten by the\n          # unscoped default `buildkit` scope: the GitHub Actions cache is a\n          # 10 GB repository-wide pool with LRU eviction, and unscoped\n          # mode=max exports of every intermediate layer crowd out the caches\n          # the rest of the pipeline reads.\n          cache-from: type=gha,scope=docker-image\n          cache-to: type=gha,mode=max,scope=docker-image\n\n  # === DOCUMENTATION VALIDATION ===\n  # Validate documentation files when docs change (hive-mind principle #12)\n  validate-docs:\n    name: Validate Documentation\n    runs-on: ubuntu-24.04\n    # Typical run: <10s. Pure shell checks over documentation files.\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-validate-docs\n      cancel-in-progress: true\n    needs: [detect-changes]\n    if: |\n      needs.detect-changes.outputs.docs-changed == 'true'\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      # Documentation line limits (1500 lines, matching the architecture\n      # limit) are enforced by the check-file-line-limits job, which scans\n      # every .md file. This job validates that the required documents\n      # exist AND still carry the sections readers depend on -- a deleted\n      # section is an ordinary diff hunk, and is exactly what review skims\n      # past. The requirement table lives in\n      # scripts/check-required-docs.sh; `--list` prints it for tests and\n      # reviewers.\n      - name: Check required documentation sections\n        run: bash scripts/check-required-docs.sh\n\n  # Principle 16 of the shared CI/CD best practices: prove the release\n  # credentials can write before the expensive jobs spend their minutes\n  # (issues #176, #181). A non-empty secret proves nothing -- an expired\n  # token is non-empty -- and a login proves authentication, not\n  # authorisation, so scripts/preflight-credentials.sh probes with an\n  # attempted write: a refused credential fails the run seconds in instead\n  # of surfacing as a registry error after the matrix.\n  release-preflight:\n    name: Release Preflight\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    permissions:\n      contents: read\n      # The runner injects ACTIONS_ID_TOKEN_REQUEST_URL only when the job may\n      # mint OIDC tokens. npm publishes with provenance, so its absence --\n      # mirrored in the publishing jobs' permission envelope -- is itself the\n      # finding.\n      id-token: write\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Probe every release credential\n        env:\n          # Release mode (push to main, manual instant release) fails the run\n          # on a refused credential. Report mode (pull requests -- a fork has\n          # no publishing secrets) runs the same probes and annotates without\n          # blocking.\n          PREFLIGHT_MODE: >-\n            ${{\n              (\n                (github.event_name == 'push' && github.ref == 'refs/heads/main') ||\n                (github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'instant')\n              ) && 'release' || 'report'\n            }}\n          NPM_TOKEN: ${{ secrets.NPM_TOKEN }}\n          DOCKERHUB_IMAGE: ${{ vars.DOCKERHUB_IMAGE }}\n          DOCKERHUB_USERNAME: ${{ vars.DOCKERHUB_USERNAME }}\n          DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}\n        run: bash scripts/preflight-credentials.sh\n\n  # Release - only runs on main after tests pass (for push events)\n  release:\n    name: Release\n    needs:\n      [\n        detect-changes,\n        test-compilation,\n        check-file-line-limits,\n        version-check,\n        changeset-check,\n        lint,\n        test,\n        session-publication,\n        docker-build,\n        validate-docs,\n        release-preflight,\n      ]\n    # Registry verification can take over 15 minutes after a successful publish.\n    timeout-minutes: 65\n    concurrency:\n      group: main-writer-${{ github.repository }}-main\n      cancel-in-progress: false\n      queue: max\n    # Use !cancelled() instead of always() so cancellation propagates correctly (hive-mind issue #1278)\n    # This is needed because lint/test jobs have a transitive dependency on changeset-check\n    if: |\n      !cancelled() &&\n      github.ref == 'refs/heads/main' &&\n      github.event_name == 'push' &&\n      needs.release-preflight.result == 'success' &&\n      needs.lint.result == 'success' &&\n      needs.test.result == 'success' &&\n      !contains(needs.*.result, 'failure') &&\n      !contains(needs.*.result, 'cancelled')\n    runs-on: ubuntu-24.04\n    # Permissions required for npm OIDC trusted publishing\n    permissions:\n      contents: write\n      pull-requests: write\n      checks: write\n      id-token: write\n    outputs:\n      published: ${{ steps.publish.outputs.published }}\n      published_version: ${{ steps.publish.outputs.published_version }}\n    steps:\n      # One of two checkouts in this workflow that keep credentials in\n      # .git/config: scripts/version-and-commit.mjs runs\n      # `git push origin main` to publish the version bump, which needs the\n      # token wired into the remote. Every other checkout in this\n      # repository sets persist-credentials: false.\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: true\n          fetch-depth: 0\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n          registry-url: 'https://registry.npmjs.org'\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Remove deprecated npm auth config\n        run: node scripts/sanitize-npm-userconfig.mjs\n\n      # Fail-closed before the install step: changesets 3.x shells out to the\n      # detected package manager, and a foreign lockfile at the root\n      # (deno.lock is here for the Deno test leg) outranks package-lock.json\n      # in package-manager-detector's probe order unless package.json\n      # declares the manager. The requirement table lives in the script.\n      - name: Check package manager declaration and lockfiles\n        run: node scripts/check-package-manager.mjs\n\n      - name: Install dependencies\n        run: bash scripts/run-with-budget-warning.sh 240 \"Release dependency install\" npm ci\n\n      - name: Update npm for OIDC trusted publishing\n        run: node scripts/setup-npm.mjs\n\n      - name: Check for changesets\n        id: check_changesets\n        run: node scripts/check-changesets.mjs\n\n      - name: Check if release is needed\n        id: check_release\n        env:\n          HAS_CHANGESETS: ${{ steps.check_changesets.outputs.has_changesets }}\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n        run: node scripts/check-release-needed.mjs\n\n      - name: Merge multiple changesets\n        if: steps.check_changesets.outputs.has_changesets == 'true' && steps.check_changesets.outputs.changeset_count > 1\n        run: |\n          echo \"Multiple changesets detected, merging...\"\n          node scripts/merge-changesets.mjs\n\n      - name: Version packages and commit to main\n        if: steps.check_changesets.outputs.has_changesets == 'true'\n        id: version\n        env:\n          # Prefer the dedicated actor when configured. Otherwise the built-in\n          # token attests a metadata-only version commit after parent validation.\n          RELEASE_PR_TOKEN: ${{ secrets.RELEASE_PR_TOKEN }}\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          RELEASE_METADATA_PATHS: ${{ vars.RELEASE_METADATA_PATHS }}\n        run: node scripts/version-and-commit.mjs --mode changeset\n\n      - name: Publish to npm\n        # Run if version was committed, if a previous attempt already committed (for re-runs),\n        # or if check-release-needed detected an unpublished version (self-healing, issue #36)\n        if: >-\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true' ||\n          (steps.check_release.outputs.should_release == 'true' && steps.check_release.outputs.skip_bump == 'true')\n        id: publish\n        # Optional NPM_TOKEN bootstrap fallback. OIDC trusted publishing is the\n        # steady-state mechanism, but it cannot create a brand-new package (the\n        # first publish returns E404 because a trusted publisher can only be\n        # configured for a package that already exists). When NPM_TOKEN is set,\n        # the first publish succeeds; once the package exists and a trusted\n        # publisher is configured, OIDC takes over and the token can be removed.\n        # See issue #77.\n        env:\n          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}\n        run: bash scripts/run-with-budget-warning.sh 1800 \"npm publish and registry verification\" node scripts/publish-to-npm.mjs --should-pull\n\n      - name: Smoke-test published npm package\n        if: steps.publish.outputs.published == 'true'\n        env:\n          PACKAGE_VERSION: ${{ steps.publish.outputs.published_version }}\n        run: bash scripts/run-with-budget-warning.sh 600 \"npm package smoke test\" node scripts/smoke-test-package.mjs --package-version \"$PACKAGE_VERSION\"\n\n      - name: Create GitHub Release\n        if: steps.publish.outputs.published == 'true'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          PACKAGE_VERSION: ${{ steps.publish.outputs.published_version }}\n          REPOSITORY: ${{ github.repository }}\n        run: node scripts/create-github-release.mjs --release-version \"$PACKAGE_VERSION\" --repository \"$REPOSITORY\"\n\n      - name: Format GitHub release notes\n        if: steps.publish.outputs.published == 'true'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          PACKAGE_VERSION: ${{ steps.publish.outputs.published_version }}\n          REPOSITORY: ${{ github.repository }}\n          COMMIT_SHA: ${{ github.sha }}\n        run: node scripts/format-github-release.mjs --release-version \"$PACKAGE_VERSION\" --repository \"$REPOSITORY\" --commit-sha \"$COMMIT_SHA\"\n\n  # Manual Instant Release - triggered via workflow_dispatch with instant mode\n  # This job is in release.yml because npm trusted publishing\n  # only allows one workflow file to be registered as a trusted publisher\n  instant-release:\n    name: Instant Release\n    # Publishing must wait for both quality gates and require explicit success.\n    needs:\n      [\n        detect-changes,\n        test-compilation,\n        check-file-line-limits,\n        version-check,\n        changeset-check,\n        lint,\n        test,\n        session-publication,\n        docker-build,\n        validate-docs,\n        release-preflight,\n      ]\n    if: |\n      !cancelled() &&\n      github.event_name == 'workflow_dispatch' &&\n      github.event.inputs.release_mode == 'instant' &&\n      github.ref == 'refs/heads/main' &&\n      needs.release-preflight.result == 'success' &&\n      needs.lint.result == 'success' &&\n      needs.test.result == 'success' &&\n      !contains(needs.*.result, 'failure') &&\n      !contains(needs.*.result, 'cancelled')\n    runs-on: ubuntu-24.04\n    # Same publish envelope as the automated release path.\n    timeout-minutes: 65\n    concurrency:\n      group: main-writer-${{ github.repository }}-main\n      cancel-in-progress: false\n      queue: max\n    # Permissions required for npm OIDC trusted publishing\n    permissions:\n      contents: write\n      pull-requests: write\n      checks: write\n      id-token: write\n    outputs:\n      published: ${{ steps.publish.outputs.published }}\n      published_version: ${{ steps.publish.outputs.published_version }}\n    steps:\n      # The second checkout in this workflow that keeps credentials in\n      # .git/config: scripts/version-and-commit.mjs pushes the version\n      # commit to main, which needs the token wired into the remote.\n      # Every other checkout in this repository sets\n      # persist-credentials: false.\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: true\n          fetch-depth: 0\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n          registry-url: 'https://registry.npmjs.org'\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Remove deprecated npm auth config\n        run: node scripts/sanitize-npm-userconfig.mjs\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Update npm for OIDC trusted publishing\n        run: node scripts/setup-npm.mjs\n\n      - name: Version packages and commit to main\n        id: version\n        env:\n          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\n          RELEASE_DESCRIPTION: ${{ github.event.inputs.description }}\n          # See the release job above (issues #143, #192, and #196).\n          RELEASE_PR_TOKEN: ${{ secrets.RELEASE_PR_TOKEN }}\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          RELEASE_METADATA_PATHS: ${{ vars.RELEASE_METADATA_PATHS }}\n        run: node scripts/version-and-commit.mjs --mode instant --bump-type \"$BUMP_TYPE\" --description \"$RELEASE_DESCRIPTION\"\n\n      - name: Publish to npm\n        # Run if version was committed OR if a previous attempt already committed (for re-runs)\n        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n        id: publish\n        # Optional NPM_TOKEN bootstrap fallback; OIDC trusted publishing is used\n        # when the secret is unset. See the release job above for details (#77).\n        env:\n          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}\n        run: bash scripts/run-with-budget-warning.sh 1800 \"npm publish and registry verification\" node scripts/publish-to-npm.mjs\n\n      - name: Smoke-test published npm package\n        if: steps.publish.outputs.published == 'true'\n        env:\n          PACKAGE_VERSION: ${{ steps.publish.outputs.published_version }}\n        run: bash scripts/run-with-budget-warning.sh 600 \"npm package smoke test\" node scripts/smoke-test-package.mjs --package-version \"$PACKAGE_VERSION\"\n\n      - name: Create GitHub Release\n        if: steps.publish.outputs.published == 'true'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          PACKAGE_VERSION: ${{ steps.publish.outputs.published_version }}\n          REPOSITORY: ${{ github.repository }}\n        run: node scripts/create-github-release.mjs --release-version \"$PACKAGE_VERSION\" --repository \"$REPOSITORY\"\n\n      - name: Format GitHub release notes\n        if: steps.publish.outputs.published == 'true'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          PACKAGE_VERSION: ${{ steps.publish.outputs.published_version }}\n          REPOSITORY: ${{ github.repository }}\n          COMMIT_SHA: ${{ github.sha }}\n        run: node scripts/format-github-release.mjs --release-version \"$PACKAGE_VERSION\" --repository \"$REPOSITORY\" --commit-sha \"$COMMIT_SHA\"\n\n  # Optional Docker Hub publishing for packages that also ship Docker images.\n  # Set vars.DOCKERHUB_IMAGE to enable this path, then configure\n  # vars.DOCKERHUB_USERNAME and secrets.DOCKERHUB_TOKEN.\n  docker-publish-config:\n    name: Configure Docker Hub Publish\n    needs: [release, instant-release, release-preflight]\n    timeout-minutes: 45\n    concurrency:\n      group: main-writer-${{ github.repository }}-main\n      cancel-in-progress: false\n      queue: max\n    if: |\n      !cancelled() &&\n      needs.release-preflight.result == 'success' &&\n      (\n        (needs.release.result == 'success' && needs.release.outputs.published == 'true') ||\n        (needs.instant-release.result == 'success' && needs.instant-release.outputs.published == 'true')\n      )\n    runs-on: ubuntu-24.04\n    permissions:\n      contents: read\n    outputs:\n      context: ${{ steps.docker_config.outputs.context }}\n      dockerfile: ${{ steps.docker_config.outputs.dockerfile }}\n      enabled: ${{ steps.docker_config.outputs.enabled }}\n      image: ${{ steps.docker_config.outputs.image }}\n      version: ${{ steps.release_version.outputs.version }}\n    env:\n      DOCKER_CONTEXT: ${{ vars.DOCKER_CONTEXT }}\n      DOCKERFILE: ${{ vars.DOCKERFILE }}\n      DOCKERHUB_IMAGE: ${{ vars.DOCKERHUB_IMAGE }}\n      DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}\n      DOCKERHUB_USERNAME: ${{ vars.DOCKERHUB_USERNAME }}\n      RELEASE_VERSION: ${{ needs.release.outputs.published_version || needs.instant-release.outputs.published_version }}\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Check Docker publish configuration\n        id: docker_config\n        run: node scripts/check-docker-publish.mjs\n\n      - name: Export release version\n        id: release_version\n        env:\n          VERSION: ${{ env.RELEASE_VERSION }}\n        run: echo \"version=${VERSION}\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Wait for npm package availability before Docker publish\n        if: steps.docker_config.outputs.enabled == 'true'\n        env:\n          VERSION: ${{ env.RELEASE_VERSION }}\n        run: bash scripts/run-with-budget-warning.sh 1800 \"Docker npm availability wait\" node scripts/wait-for-npm.mjs --release-version \"${VERSION}\"\n\n  # Build each architecture on a native runner. Each build is pushed by digest;\n  # docker-publish combines those immutable digests into the release tags.\n  docker-publish-build:\n    name: Build Docker Image\n    needs: [docker-publish-config]\n    if: needs.docker-publish-config.outputs.enabled == 'true'\n    timeout-minutes: 30\n    strategy:\n      fail-fast: false\n      matrix:\n        include:\n          - platform: linux/amd64\n            runner: ubuntu-24.04\n          - platform: linux/arm64\n            runner: ubuntu-24.04-arm\n    runs-on: ${{ matrix.runner }}\n    permissions:\n      contents: read\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Build and push platform image by digest\n        id: build\n        # Step-level budget below the job's timeout-minutes backstop; see\n        # docs/legacy/CI-TIMEOUT-BUDGETS.md.\n        timeout-minutes: 20\n        uses: ./.github/actions/publish-dockerhub\n        with:\n          context: ${{ needs.docker-publish-config.outputs.context }}\n          file: ${{ needs.docker-publish-config.outputs.dockerfile }}\n          image: ${{ needs.docker-publish-config.outputs.image }}\n          platform: ${{ matrix.platform }}\n          token: ${{ secrets.DOCKERHUB_TOKEN }}\n          username: ${{ vars.DOCKERHUB_USERNAME }}\n          version: ${{ needs.docker-publish-config.outputs.version }}\n\n      - name: Export image digest\n        env:\n          DIGEST: ${{ steps.build.outputs.digest }}\n        run: |\n          mkdir -p /tmp/digests\n          touch \"/tmp/digests/${DIGEST#sha256:}\"\n\n      - name: Upload image digest\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: docker-digest-${{ strategy.job-index }}\n          path: /tmp/digests/*\n          if-no-files-found: error\n          retention-days: 1\n\n  docker-publish:\n    name: Optional Docker Hub Publish\n    needs: [docker-publish-config, docker-publish-build]\n    if: needs.docker-publish-build.result == 'success'\n    timeout-minutes: 30\n    concurrency:\n      group: main-writer-${{ github.repository }}-main\n      cancel-in-progress: false\n      queue: max\n    runs-on: ubuntu-24.04\n    permissions:\n      contents: read\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Set up Docker Buildx (resilient)\n        uses: ./.github/actions/setup-buildx-resilient\n\n      - name: Log in to Docker Hub\n        uses: docker/login-action@v4.8.0\n        with:\n          username: ${{ vars.DOCKERHUB_USERNAME }}\n          password: ${{ secrets.DOCKERHUB_TOKEN }}\n\n      - name: Download image digests\n        uses: ./.github/actions/artifact-transport\n        env:\n          NODE_OPTIONS: --pending-deprecation --throw-deprecation\n        with:\n          path: /tmp/digests\n          pattern: docker-digest-*\n          mode: download\n\n      - name: Create multi-architecture manifest\n        working-directory: /tmp/digests\n        env:\n          IMAGE: ${{ needs.docker-publish-config.outputs.image }}\n          VERSION: ${{ needs.docker-publish-config.outputs.version }}\n        run: |\n          # One argument per digest. An array keeps the expansion explicit\n          # instead of relying on word splitting of a command substitution.\n          mapfile -t digests < <(printf \"${IMAGE}@sha256:%s\\n\" *)\n          if [[ \"${#digests[@]}\" -ne 2 ]]; then\n            echo \"Expected 2 platform digests, found ${#digests[@]}.\" >&2\n            exit 1\n          fi\n          docker buildx imagetools create \\\n            --tag \"${IMAGE}:latest\" \\\n            --tag \"${IMAGE}:${VERSION}\" \\\n            \"${digests[@]}\"\n\n      - name: Verify published multi-architecture manifests\n        env:\n          IMAGE: ${{ needs.docker-publish-config.outputs.image }}\n          VERSION: ${{ needs.docker-publish-config.outputs.version }}\n        run: |\n          for tag in latest \"${VERSION}\"; do\n            if ! manifest=\"$(docker buildx imagetools inspect \"${IMAGE}:${tag}\")\"; then\n              echo \"Unable to read back published manifest ${IMAGE}:${tag}\" >&2\n              exit 1\n            fi\n            for platform in linux/amd64 linux/arm64; do\n              if ! grep -Eq \"Platform:[[:space:]]+${platform}\" <<<\"${manifest}\"; then\n                echo \"Published manifest ${IMAGE}:${tag} is missing ${platform}\" >&2\n                exit 1\n              fi\n            done\n          done\n\n  # Manual Changeset PR - creates a pull request with the changeset for review\n  changeset-pr:\n    name: Create Changeset PR\n    # PR creation does not publish, but it must still pass the fast lint gate.\n    needs: [lint]\n    if: |\n      !cancelled() &&\n      github.event_name == 'workflow_dispatch' &&\n      github.event.inputs.release_mode == 'changeset-pr' &&\n      needs.lint.result == 'success'\n    runs-on: ubuntu-24.04\n    # PR creation only: install, create a changeset, format, and open a PR.\n    timeout-minutes: 10\n    concurrency:\n      group: main-writer-${{ github.repository }}-main\n      cancel-in-progress: false\n      queue: max\n    permissions:\n      contents: read\n    steps:\n      # peter-evans/create-pull-request receives the dedicated token directly;\n      # dependency installation does not need a credential in .git/config.\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Require release pull-request token\n        env:\n          RELEASE_PR_TOKEN: ${{ secrets.RELEASE_PR_TOKEN }}\n        run: |\n          if [[ -z \"$RELEASE_PR_TOKEN\" ]]; then\n            echo \"::error::RELEASE_PR_TOKEN is required to create a changeset pull request.\"\n            exit 1\n          fi\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Create changeset file\n        env:\n          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\n          RELEASE_DESCRIPTION: ${{ github.event.inputs.description }}\n        run: node scripts/create-manual-changeset.mjs --bump-type \"$BUMP_TYPE\" --description \"$RELEASE_DESCRIPTION\"\n\n      - name: Format changeset with Prettier\n        run: |\n          # Run Prettier on the changeset file to ensure it matches project style\n          npx prettier --write \".changeset/*.md\"\n\n          echo \"Formatted changeset files\"\n\n      - name: Create Pull Request\n        uses: peter-evans/create-pull-request@5f6978faf089d4d20b00c7766989d076bb2fc7f1 # v8.1.1\n        with:\n          # The built-in token suppresses pull_request workflows; use the same\n          # dedicated automation actor as the release fallback (issue #192).\n          token: ${{ secrets.RELEASE_PR_TOKEN }}\n          commit-message: 'chore: add changeset for manual ${{ github.event.inputs.bump_type }} release'\n          branch: changeset-manual-release-${{ github.run_id }}\n          delete-branch: true\n          title: 'chore: manual ${{ github.event.inputs.bump_type }} release'\n          body: |\n            ## Manual Release Request\n\n            This PR was created by a manual workflow trigger to prepare a **${{ github.event.inputs.bump_type }}** release.\n\n            ### Release Details\n            - **Type:** ${{ github.event.inputs.bump_type }}\n            - **Description:** ${{ github.event.inputs.description || 'Manual release' }}\n            - **Triggered by:** @${{ github.actor }}\n\n            ### Next Steps\n            1. Review the changeset in this PR\n            2. Merge this PR to main\n            3. The automated release workflow will validate and commit version metadata\n            4. It will publish to npm and create a GitHub release after the metadata push succeeds\n\n  # GitHub reports jobs killed by timeout-minutes as cancelled rather than\n  # failed. Observe every job and excuse only cancellations that the tested\n  # workflow explicitly permits when a newer commit supersedes this run.\n  pipeline-status:\n    name: Pipeline Status\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-pipeline-status\n      cancel-in-progress: true\n    if: >-\n      !cancelled()\n    needs:\n      - detect-changes\n      - test-compilation\n      - check-file-line-limits\n      - version-check\n      - changeset-check\n      - lint\n      - test\n      - session-publication\n      - docker-build\n      - docker-publish-config\n      - docker-publish-build\n      - validate-docs\n      - release-preflight\n      - release\n      - instant-release\n      - docker-publish\n      - changeset-pr\n    permissions:\n      actions: read\n      contents: read\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7.1.0\n        with:\n          node-version: '26.13.0'\n\n      - name: Install reviewed npm\n        run: npm install --global npm@12.2.2 --ignore-scripts --no-audit --no-fund\n\n      - name: Fail the run when a required job was cancelled or failed\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          RUN_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n          GH_TOKEN: ${{ github.token }}\n          HEAD_REF: ${{ github.event_name == 'pull_request' && format('refs/pull/{0}/head', github.event.number) || github.ref }}\n        run: bash scripts/check-pipeline-status.sh\n"
