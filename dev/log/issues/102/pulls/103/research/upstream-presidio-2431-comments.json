[{"url":"https://api.github.com/repos/data-privacy-stack/presidio/issues/comments/6497956025","html_url":"https://github.com/data-privacy-stack/presidio/issues/2431#issuecomment-6497956025","issue_url":"https://api.github.com/repos/data-privacy-stack/presidio/issues/2431","id":6497956025,"node_id":"IC_kwDOB-Aj2M8AAAABg07wuQ","user":{"login":"ldej","id":18293312,"node_id":"MDQ6VXNlcjE4MjkzMzEy","avatar_url":"https://avatars.githubusercontent.com/u/18293312?v=4","gravatar_id":"","url":"https://api.github.com/users/ldej","html_url":"https://github.com/ldej","followers_url":"https://api.github.com/users/ldej/followers","following_url":"https://api.github.com/users/ldej/following{/other_user}","gists_url":"https://api.github.com/users/ldej/gists{/gist_id}","starred_url":"https://api.github.com/users/ldej/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ldej/subscriptions","organizations_url":"https://api.github.com/users/ldej/orgs","repos_url":"https://api.github.com/users/ldej/repos","events_url":"https://api.github.com/users/ldej/events{/privacy}","received_events_url":"https://api.github.com/users/ldej/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-29T13:26:52Z","updated_at":"2026-10-29T13:26:52Z","body":"Related pin in the same release: `presidio-analyzer` 2.2.366 also requires `numpy<2.5.0`.\n\n`numpy` 2.4.6 has no cp315 wheel, so on Python 3.15 that cap forces a source build of numpy too, which means a C toolchain in every downstream image. `numpy` 2.5.x ships the wheel, and the packages around it here accept it (`numba` 0.68 allows `<2.6`, `scipy` 1.17 allows `<2.7`, `thinc` 8.3 allows `<3`), so it looks like the cap could move with them.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/data-privacy-stack/presidio/issues/comments/6497956025/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]