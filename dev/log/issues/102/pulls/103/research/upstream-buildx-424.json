/danielamar101-pton","followers_url":"https://api.github.com/users/danielamar101-pton/followers","following_url":"https://api.github.com/users/danielamar101-pton/following{/other_user}","gists_url":"https://api.github.com/users/danielamar101-pton/gists{/gist_id}","starred_url":"https://api.github.com/users/danielamar101-pton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielamar101-pton/subscriptions","organizations_url":"https://api.github.com/users/danielamar101-pton/orgs","repos_url":"https://api.github.com/users/danielamar101-pton/repos","events_url":"https://api.github.com/users/danielamar101-pton/events{/privacy}","received_events_url":"https://api.github.com/users/danielamar101-pton/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":3,"created_at":"2025-05-05T20:44:06Z","updated_at":"2026-03-03T12:41:46Z","closed_at":"2026-03-03T12:40:53Z","assignee":{"login":"danielamar101-pton","id":195569015,"node_id":"U_kgDOC6gldw","avatar_url":"https://avatars.githubusercontent.com/u/195569015?v=4","gravatar_id":"","url":"https://api.github.com/users/danielamar101-pton","html_url":"https://github.com/danielamar101-pton","followers_url":"https://api.github.com/users/danielamar101-pton/followers","following_url":"https://api.github.com/users/danielamar101-pton/following{/other_user}","gists_url":"https://api.github.com/users/danielamar101-pton/gists{/gist_id}","starred_url":"https://api.github.com/users/danielamar101-pton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielamar101-pton/subscriptions","organizations_url":"https://api.github.com/users/danielamar101-pton/orgs","repos_url":"https://api.github.com/users/danielamar101-pton/repos","events_url":"https://api.github.com/users/danielamar101-pton/events{/privacy}","received_events_url":"https://api.github.com/users/danielamar101-pton/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/docker/setup-buildx-action/pulls/424","html_url":"https://github.com/docker/setup-buildx-action/pull/424","diff_url":"https://github.com/docker/setup-buildx-action/pull/424.diff","patch_url":"https://github.com/docker/setup-buildx-action/pull/424.patch","merged_at":null},"body":"This should fix: https://github.com/docker/setup-buildx-action/issues/283\r\n\r\nThere is a race condition in the buildx setup process:\r\n\r\n- When the action runs docker buildx inspect --bootstrap --builder <builder-name>, it's trying to initialize the buildkit daemon.\r\n- The error occurs because the action is trying to communicate with buildkit via its socket file (/run/buildkit/buildkitd.sock) before the daemon is fully initialized.\r\n\r\nThe fix here is to continue retrying until the daemon is fully initialized, and timing the bootstrap out after 15 seconds to attempt a retry, instead of waiting many minutes.\r\n\r\nTry and replace `docker/setup-buildx-action@v3`  with: `danielamar101-pton/setup-buildx-action@fix-buildx-bootstrap-race-condition`  to use my version, and notice a reduction in waiting for this action.","closed_by":{"login":"crazy-max","id":1951866,"node_id":"MDQ6VXNlcjE5NTE4NjY=","avatar_url":"https://avatars.githubusercontent.com/u/1951866?v=4","gravatar_id":"","url":"https://api.github.com/users/crazy-max","html_url":"https://github.com/crazy-max","followers_url":"https://api.github.com/users/crazy-max/followers","following_url":"https://api.github.com/users/crazy-max/following{/other_user}","gists_url":"https://api.github.com/users/crazy-max/gists{/gist_id}","starred_url":"https://api.github.com/users/crazy-max/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/crazy-max/subscriptions","organizations_url":"https://api.github.com/users/crazy-max/orgs","repos_url":"https://api.github.com/users/crazy-max/repos","events_url":"https://api.github.com/users/crazy-max/events{/privacy}","received_events_url":"https://api.github.com/users/crazy-max/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/docker/setup-buildx-action/issues/424/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/docker/setup-buildx-action/issues/424/timeline","performed_via_github_app":null,"state_reason":null}