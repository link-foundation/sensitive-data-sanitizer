TH silently skips the shell checks and exits 0 - worth knowing when\n      # reproducing a failure locally:\n      #   docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12 -color\n      # Pinned by digest because a mutable tag of a repository we do not\n      # control is arbitrary code execution in any job that holds\n      # credentials (the same reasoning as the `'*': hash-pin` policy in\n      # .github/zizmor.yml). Re-resolve when bumping:\n      #   docker pull rhysd/actionlint:<tag> &&\n      #   docker inspect --format='{{index .RepoDigests 0}}' rhysd/actionlint:<tag>\n      - uses: docker://rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 # v1.7.12\n        with:\n          # queue:max is supported by GitHub; actionlint's schema lags it.\n          args: -color -ignore \"unexpected key .queue. for .concurrency. section\"\n\n  shellcheck:\n    name: ShellCheck\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-shellcheck\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Check standalone shell scripts and hooks\n        run: git ls-files -z '*.sh' '.husky/*' | xargs -0 pipx run --spec shellcheck-py==0.11.0.1 shellcheck\n\n  python-check:\n    name: Python static checks\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-python-check\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Lint every maintained Python helper\n        run: pipx run --spec ruff==0.17.3 ruff check --output-format=github .\n      - name: Check Python formatting\n        run: pipx run --spec ruff==0.17.3 ruff format --check .\n      - name: Test Python dependency audit failures and discovery\n        run: python3 -m unittest discover -s tests/python -v\n\n  # The terminal status job of release.yml keys branch protection; its\n  # needs list is hand-maintained, so a job left out of it could fail while\n  # the gate reports success. This derives the requirement from the\n  # workflow itself.\n  status-gate-coverage:\n    name: Status Gate Coverage\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-status-gate-coverage\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Check pinned workflow tooling and hosted runners\n        run: node scripts/check-ci-workflows.mjs\n\n      - name: Check the status gate covers every job\n        # Every workflow here runs a hand-maintained pipeline-status gate;\n        # this derives each requirement from the workflow itself.\n        run: >-\n          node scripts/check-status-gate-covers-all-jobs.mjs\n          .github/workflows/release.yml\n          .github/workflows/links.yml\n          .github/workflows/security.yml\n          .github/workflows/workflows.yml\n          .github/workflows/example-app.yml\n\n  zizmor:\n    name: zizmor\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-zizmor\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      # Annotations instead of SARIF: forks of this template do not necessarily\n      # have code scanning enabled, and the job should fail loudly either way.\n      #\n      # Named `version` rather than left at the default, because the action's\n      # `latest` entry is its own frozen table (v0.6.4 -> zizmor 1.30.1), not\n      # the latest zizmor. Naming it keeps the next bump a visible line in the\n      # diff rather than a side effect of bumping the action, and documents\n      # exactly which analyser reproduces a finding:\n      #   pipx run zizmor==1.30.1 --config .github/zizmor.yml \\\n      #     --min-confidence low --persona regular .\n      - uses: zizmorcore/zizmor-action@v0.8.0\n        with:\n          advanced-security: false\n          annotations: true\n          config: .github/zizmor.yml\n          # Low, not medium: the artipacked audit reports at Low confidence,\n          # and a floor above the finding hides every checkout that forgets\n          # persist-credentials: false. tests/checkout-credentials.test.js\n          # pins the same invariant in-repo, so the floor only needs to catch\n          # the workflows the test cannot see.\n          min-confidence: low\n          version: 1.30.1\n\n      # The job above runs `--persona regular`, which is the right default:\n      # pedantic surfaces dozens of stylistic findings. But the audits that\n      # cover container image references (`unpinned-images` among them) are\n      # Pedantic-only, so the `'*': hash-pin` policy declared in\n      # .github/zizmor.yml is not enforced against `uses: docker://` or\n      # `container:` references by the run above. Narrowing this second pass\n      # to high severity *and* high confidence keeps that enforcement without\n      # importing the noise. Measured: after the digest pins below it reports\n      # nothing, and stays silent until someone reintroduces a mutable image.\n      - name: Audit for pedantic-only high-severity findings\n        timeout-minutes: 10\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          pipx run zizmor==1.30.1 --config .github/zizmor.yml \\\n            --persona pedantic --min-severity high --min-confidence high \\\n            .\n\n  artifact-roundtrip:\n    name: Artifact Transport Regression\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-artifacts\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n\n      - name: Install pinned artifact dependencies\n        run: npm ci --prefix .github/actions/artifact-transport --ignore-scripts --no-audit --no-fund\n\n      - name: Exercise actual SDK archive dependencies\n        run: node --pending-deprecation --throw-deprecation scripts/check-artifact-archive.mjs\n\n      - name: Prepare roundtrip evidence\n        run: |\n          mkdir -p \"$RUNNER_TEMP/artifact-evidence/nested\" \"$RUNNER_TEMP/pages-evidence\"\n          printf '\\000\\377\\102' > \"$RUNNER_TEMP/artifact-evidence/nested/bytes.bin\"\n          touch \"$RUNNER_TEMP/artifact-evidence/empty\"\n          printf '<html>artifact transport regression</html>' > \"$RUNNER_TEMP/pages-evidence/index.html\"\n\n      - name: Upload roundtrip evidence\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: transport-roundtrip\n          path: ${{ runner.temp }}/artifact-evidence\n          retention-days: 1\n\n      - name: Download with deprecations treated as errors\n        uses: ./.github/actions/artifact-transport\n        env:\n          NODE_OPTIONS: --pending-deprecation --throw-deprecation\n        with:\n          mode: download\n          pattern: transport-roundtrip\n          path: ${{ runner.temp }}/artifact-downloaded\n\n      - name: Verify every downloaded byte\n        run: diff -r \"$RUNNER_TEMP/artifact-evidence\" \"$RUNNER_TEMP/artifact-downloaded\"\n\n      - name: Upload Pages roundtrip evidence\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: pages-roundtrip\n          pages: true\n          path: ${{ runner.temp }}/pages-evidence\n          retention-days: 1\n\n      - name: Download Pages archive\n        uses: ./.github/actions/artifact-transport\n        env:\n          NODE_OPTIONS: --pending-deprecation --throw-deprecation\n        with:\n          mode: download\n          pattern: pages-round*\n          path: ${{ runner.temp }}/pages-downloaded\n\n      - name: Verify Pages tar content\n        run: |\n          mkdir -p \"$RUNNER_TEMP/pages-unpacked\"\n          tar -xf \"$RUNNER_TEMP/pages-downloaded/artifact.tar\" -C \"$RUNNER_TEMP/pages-unpacked\"\n          diff -r \"$RUNNER_TEMP/pages-evidence\" \"$RUNNER_TEMP/pages-unpacked\"\n\n  # Terminal status gate: runs even when the jobs above fail or are\n  # cancelled, and turns a `timeout-minutes` kill (reported as cancelled)\n  # into a red run. needs is derived and checked by the\n  # status-gate-coverage job above.\n  pipeline-status:\n    name: Pipeline Status\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-pipeline-status\n      cancel-in-progress: true\n    # A status function is required: without one the gate inherits the\n    # implicit \"every dependency succeeded\" condition and is skipped in\n    # exactly the runs it exists to report.\n    if: >-\n      !cancelled()\n    needs:\n      - actionlint\n      - status-gate-coverage\n      - zizmor\n      - shellcheck\n      - python-check\n      - artifact-roundtrip\n    # actions: read lets the gate list this run's jobs and name the ones\n    # GitHub never acquired a runner for.\n    permissions:\n      actions: read\n      contents: read\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n\n      - name: Fail the run when a required job was cancelled or failed\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          GH_TOKEN: ${{ github.token }}\n          RUN_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n          HEAD_REF: ${{ github.event_name == 'pull_request' && format('refs/pull/{0}/head', github.event.number) || github.ref }}\n        run: bash scripts/check-pipeline-status.sh\n" to contain "zizmorcore/zizmor-action@v0.6.4"
