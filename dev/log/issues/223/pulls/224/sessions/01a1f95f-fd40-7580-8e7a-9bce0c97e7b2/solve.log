ype': 'git', 'url': 'git://github.com/microsoft/node-pty.git'}, 'version': '1.1.0'}\ntest-anywhere {'engines': {'node': '>=20.0.0'}, 'repository': {'type': 'git', 'url': 'git+https://github.com/link-foundation/test-anywhere.git'}, 'version': '0.9.1'}\nre2js {'engines': {'node': '>=20.0.0'}, 'repository': {'type': 'git', 'url': 'git+https://github.com/le0pard/re2js.git'}, 'version': '2.10.0'}\ncommand-stream {'dependencies': {'acorn': '8.19.0', 'cross-spawn': '7.0.6', 'execa': '10.2.1', 'meta-language': '^0.46.0'}, 'engines': {'bun': '>=1.0.0', 'node': '>=22.0.0'}, 'optionalDependencies': {'node-pty': '^1.1.0'}, 'peerDependencies': {'@resvg/resvg-js': '^2.6.2', '@xterm/headless': '^6.0.0', 'gifenc': '^1.0.3'}, 'repository': {'directory': 'js', 'type': 'git', 'url': 'git+https://github.com/link-foundation/command-stream.git'}, 'version': '3.0.0'}\n## Behavior change: Java problem matcher is now opt-in\n\nStarting with v6.3.0, `setup-java` no longer registers the Java problem matcher by default (#1326, fixes #1322). Java compiler warnings, compiler errors, and uncaught exceptions are no longer turned into annotations on pull request diffs unless you opt in.\n\nTo keep annotations, set `problem-matcher: true`:\n\n```yaml\n- uses: actions/setup-java@v6\n  with:\n    distribution: temurin\n    java-version: '25'\n    problem-matcher: true\n```\n\nCompiler output still appears in the build logs, and compilation errors still fail the build. Only annotations are affected.\n\n**Why:** inline annotations cluttered pull request reviews, and GitHub Actions caps annotations at 10 errors, 10 warnings, and 10 notices per step, and 50 per job. Larger Java builds therefore showed only a truncated subset of their diagnostics as annotations. See [Java problem matcher (compiler annotations)](https://github.com/actions/setup-java/blob/main/docs/advanced-usage.md#java-problem-matcher-compiler-annotations).\n\n## What's Changed\n* Architecture validation for JDK file installs by @v-mahabaleshwars in https://github.com/actions/setup-java/pull/1324\n* chore(deps): bump fast-xml-parser from 5.11.2 to 5.12.0 by @dependabot[bot] in https://github.com/actions/setup-java/pull/1323\n* Add Microsoft OpenJDK 25.0.5.0.2 support by @brunoborges with @Copilot in https://github.com/actions/setup-java/pull/1320\n* Fix JetBrains Runtime hotfix version selection by @brunoborges with @Copilot in https://github.com/actions/setup-java/pull/1321\n* Make Java problem matcher opt-in (default problem-matcher to false) by @brunoborges in https://github.com/actions/setup-java/pull/1326\n\n\n**Full Changelog**: https://github.com/actions/setup-java/compare/v6.2.0...v6.3.0\n\nMinor update:\r\n\r\n- Better error information from the compare endpoint (@ahpook)\r\n- Many dependency updates\r\n\nbuildx 0.39.1\r\n\r\nWelcome to the v0.39.1 release of buildx!\r\n\r\n\r\n\r\nPlease try out the release binaries and report any issues at\r\nhttps://github.com/docker/buildx/issues.\r\n\r\n### Contributors\r\n\r\n* Tõnis Tiigi\r\n\r\n### Notable Changes\r\n\r\n- Fix regression in v0.39.0 where build could error if .dockerignore contained lots of entries\r\n\r\n\r\n### Dependency Changes\r\n\r\n* **github.com/moby/buildkit**  v0.35.0 -> v0.35.1\r\n\r\nPrevious release can be found at [v0.39.0](https://github.com/docker/buildx/releases/tag/v0.39.0)\nbuildkit 0.35.1\r\n\r\nWelcome to the v0.35.1 release of buildkit!\r\n\r\n\r\n\r\nPlease try out the release binaries and report any issues at\r\nhttps://github.com/moby/buildkit/issues.\r\n\r\n### Contributors\r\n\r\n* CrazyMax\r\n* Tõnis Tiigi\r\n\r\n### Notable Changes\r\n\r\n- Make sure empty attestation manifests are skipped #7419\r\n- Allow sharing snapshot key names with `docker pull` as was allowed before v0.33.x\r\n- Fix regression where large filesync pattern lists could cause errors #7420\r\n\r\n\r\n### Dependency Changes\r\n\r\nThis release has no dependency changes\r\n\r\nPrevious release can be found at [v0.35.0](https://github.com/moby/buildkit/releases/tag/v0.35.0)\n[{\"publishedAt\":\"2026-11-20T10:43:04Z\",\"tagName\":\"v3.39.4\"},{\"publishedAt\":\"2026-11-20T10:06:18Z\",\"tagName\":\"v4.39.4\"},{\"publishedAt\":\"2026-11-19T14:50:33Z\",\"tagName\":\"codeql-bundle-v2.27.5\"},{\"publishedAt\":\"2026-11-04T17:53:40Z\",\"tagName\":\"v3.39.3\"},{\"publishedAt\":\"2026-11-04T16:49:20Z\",\"tagName\":\"v4.39.3\"},{\"publishedAt\":\"2026-11-03T11:11:57Z\",\"tagName\":\"v3.39.2\"},{\"publishedAt\":\"2026-11-03T10:46:38Z\",\"tagName\":\"v4.39.2\"},{\"publishedAt\":\"2026-11-02T16:13:49Z\",\"tagName\":\"codeql-bundle-v2.27.4\"},{\"publishedAt\":\"2026-10-21T16:31:09Z\",\"tagName\":\"v3.39.1\"},{\"publishedAt\":\"2026-10-21T15:48:42Z\",\"tagName\":\"v4.39.1\"}]\n{\"digest\":[null],\"tagName\":\"en_core_web_sm-3.8.0\",\"url\":\"https://github.com/explosion/spacy-models/releases/tag/en_core_web_sm-3.8.0\"}\n","exit_code":0,"status":"completed"}}
