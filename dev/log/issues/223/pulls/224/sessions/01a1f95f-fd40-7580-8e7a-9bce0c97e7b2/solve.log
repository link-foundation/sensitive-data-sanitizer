/sanitizer-issue-172*.test.js) take about\n        # a minute per file on cold macOS Intel runners, so the shard holding\n        # one needs the same 200s budget as Bun. scripts/run-test-shard.mjs\n        # deals the three files to separate shards.\n        run: bash scripts/run-with-budget-warning.sh 200 \"Deno test suite\" node scripts/run-test-shard.mjs deno \"$TEST_SHARD\"\n\n  # === DOCKER IMAGE BUILD CHECK (pull requests) ===\n  # Builds the Dockerfile without pushing so a broken image fails the pull\n  # request instead of surfacing only after publish (issue #106).\n  # push: false + load: true keeps this working for fork pull requests,\n  # which have no registry credentials. Skipped when no Dockerfile exists.\n  docker-build:\n    name: Docker Image Build Check\n#!/usr/bin/env bash\n# Install the reviewed GitHub CLI inside the Linux x64 Playwright container.\n# GitHub-hosted runner utilities are not inherited by container jobs.\nset -euo pipefail\n\n: \"${RUNNER_TEMP:?RUNNER_TEMP is required}\"\n: \"${GITHUB_PATH:?GITHUB_PATH is required}\"\nif [[ \"$(uname -s)/$(uname -m)\" != Linux/x86_64 ]]; then\n  echo '::error::Preview GitHub CLI setup requires Linux x86_64.'\n  exit 1\nfi\n\nversion=2.103.3\nchecksum=4c806978ffce1cec70853302a56d70ac6da4f19bae7adca4e1a8ab00633dd91d\ninstall_dir=\"$(mktemp -d \"$RUNNER_TEMP/preview-gh.XXXXXX\")\"\narchive=\"$install_dir/gh.tar.gz\"\ntrap 'rm -f \"$archive\"' EXIT\n\n# Bound each attempt so a stalled transfer retries instead of hanging. No\n# retry starts after 50s and an attempt lasts at most 20s, so the download\n# ends within 70s, inside the step's 90s budget.\ncurl --fail --silent --show-error --location --retry 3 \\\n  --connect-timeout 15 --max-time 20 --retry-max-time 50 \\\n  \"https://github.com/cli/cli/releases/download/v${version}/gh_${version}_linux_amd64.tar.gz\" \\\n  --output \"$archive\"\nif ! printf '%s  %s\\n' \"$checksum\" \"$archive\" | sha256sum --check --status; then\n  echo '::error::Preview GitHub CLI archive checksum mismatch.' >&2\n  exit 1\nfi\ntar -xzf \"$archive\" -C \"$install_dir\" --strip-components=2 \\\n  \"gh_${version}_linux_amd64/bin/gh\"\n\"$install_dir/gh\" --version\nprintf '%s\\n' \"$install_dir\" >> \"$GITHUB_PATH\"\nimport { readFileSync } from 'node:fs';\nimport { describe, expect, it } from 'test-anywhere';\n\nconst workflow = readFileSync('.github/workflows/links.yml', 'utf8').replaceAll(\n  '\\r\\n',\n  '\\n'\n);\n\nfunction getStepBlock(stepName) {\n  const lines = workflow.split('\\n');\n  const header = `      - name: ${stepName}`;\n  const start = lines.findIndex((line) => line === header);\n\n  if (start === -1) {\n    return '';\n  }\n\n  const end = lines.findIndex(\n    (line, index) => index > start && line.startsWith('      - ')\n  );\n\n  return lines.slice(start, end === -1 ? lines.length : end).join('\\n');\n}\n\ndescribe('broken link workflow', () => {\n  it('installs a pinned release separately from the link check', () => {\n    const install = getStepBlock('Install pinned lychee with download retries');\n    expect(install).toContain(\n      'run: bash scripts/run-with-budget-warning.sh 60 \"lychee install\" bash scripts/install-lychee.sh'\n    );\n    expect(install).toContain('LYCHEE_VERSION: v0.24.2');\n    expect(workflow).not.toContain('uses: lycheeverse/lychee-action');\n    expect(workflow.indexOf(install)).toBeLessThan(\n      workflow.indexOf(getStepBlock('Check links with lychee'))\n    );\n  });\n\n  it('fails for every nonzero Lychee exit even when an archive exists', () => {\n    const failureStep = getStepBlock('Fail if broken links were found');\n\n    expect(failureStep).toContain('!cancelled()');\n    expect(failureStep).toContain('steps.lychee.outputs.exit_code != 0');\n    expect(failureStep).not.toContain('steps.webarchive.outputs.all_archived');\n    expect(failureStep).toContain(\n      'An archive is a suggested replacement; it does not make the live link valid.'\n    );\n  });\n\n  it('re-asks the links that never got an answer before giving up', () => {\n    const recheckStep = getStepBlock('Re-check transient link failures');\n\n    expect(recheckStep).toContain('id: recheck');\n    expect(recheckStep).toContain('node scripts/recheck-broken-links.mjs');\n    expect(recheckStep).toContain('if: steps.lychee.outputs.exit_code != 0');\n    expect(recheckStep).toContain('LYCHEE_OUTPUT: lychee/out.md');\ntests/workflows-lint.test.js:113:    expect(versions).toEqual(['0.17.4', '0.17.4']);\ntests/workflows-lint.test.js:121:      'pipx run --spec ruff==0.17.4 ruff check --fix --force-exclude'\ntests/ci-timeouts.test.js:864:          { name: 'continued', run: 'pipx install \\\\\\n  uv==0.13.7' },\ntests/ci-timeouts.test.js:881:      'fixture: \"continued\" runs pipx install uv==0.13.7',\ntests/security-workflow.test.js:138:    expect(audit).toContain('pipx install uv==0.13.7');\ntests/setup-buildx-resilient.test.js:15:    expect(canonical.with.version).toBe('v0.38.2');\ntests/setup-buildx-resilient.test.js:38:      'moby/buildkit:v0.34.2'\ntests/workflow-reliability.test.js:391:    expect(imageVersion).toBe('1.65.0');\ntests/setup-npm.test.js:31:    expect(compareVersions('11.10.0', '11.9.9')).toBe(1);\ntests/setup-npm.test.js:50:    expect(isSupportedNodeVersion('v26.13.0')).toBe(true);\n","exit_code":1,"status":"failed"}}
