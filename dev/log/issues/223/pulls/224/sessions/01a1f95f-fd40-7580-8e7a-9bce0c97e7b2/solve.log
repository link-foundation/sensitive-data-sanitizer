": \"^14.0.0\",\n    \"supports-color\": \"^10.2.2\",\n    \"tar\": \"^7.5.22\",\n    \"text-table\": \"~0.2.0\",\n    \"tiny-relative-date\": \"^2.0.2\",\n    \"treeverse\": \"^3.0.0\",\n    \"validate-npm-package-name\": \"^8.0.0\",\n    \"which\": \"^7.0.0\"\n  },\n  \"engines\": {\n    \"node\": \"^22.22.2 || ^24.15.0 || >=26.0.0\"\n  },\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/npm/cli.git\"\n  },\n  \"version\": \"12.2.3\"\n}\n{\n  \"dependencies\": {\n    \"async\": \"^3.2.4\",\n    \"buffer-crc32\": \"^1.0.0\",\n    \"is-stream\": \"^4.0.0\",\n    \"lazystream\": \"^1.0.0\",\n    \"normalize-path\": \"^3.0.0\",\n    \"readable-stream\": \"^4.0.0\",\n    \"readdir-glob\": \"^3.0.0\",\n    \"tar-stream\": \"^3.0.0\",\n    \"zip-stream\": \"^7.0.2\"\n  },\n  \"engines\": {\n    \"node\": \">=18\"\n  },\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/archiverjs/node-archiver.git\"\n  },\n  \"version\": \"8.0.0\"\n}\n{\n  \"dependencies\": {\n    \"glob\": \"^10.0.0\",\n    \"graceful-fs\": \"^4.2.0\",\n    \"is-stream\": \"^2.0.1\",\n    \"lazystream\": \"^1.0.0\",\n    \"lodash\": \"^4.17.15\",\n    \"normalize-path\": \"^3.0.0\",\n    \"readable-stream\": \"^4.0.0\"\n  },\n  \"engines\": {\n    \"node\": \">= 14\"\n  },\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/archiverjs/archiver-utils.git\"\n  },\n  \"version\": \"5.0.2\"\n}\n{\n  \"dependencies\": {\n    \"app-builder-lib\": \"26.18.0\",\n    \"builder-util\": \"26.16.0\",\n    \"builder-util-runtime\": \"9.7.0\",\n{\"body\":\"Related pin in the same release: `presidio-analyzer` 2.2.366 also requires `numpy\\u003c2.5.0`.\\n\\n`numpy` 2.4.6 has no cp315 wheel, so on Python 3.15 that cap forces a source build of numpy too, which means a C toolchain in every downstream image. `numpy` 2.5.x ships the wheel, and the packages around it here accept it (`numba` 0.68 allows `\\u003c2.6`, `scipy` 1.17 allows `\\u003c2.7`, `thinc` 8.3 allows `\\u003c3`), so it looks like the cap could move with them.\\n\",\"html_url\":\"https://github.com/data-privacy-stack/presidio/issues/2431#issuecomment-6497956025\"}\n{\"body\":\"Confirmed in an actual Ubuntu 24.04 CI run with the current released graph: CPython 3.15.0, presidio-analyzer 2.2.366, spaCy 3.8.18, preshed 3.0.13 and en_core_web_sm 3.8.0. Package installation, `uv pip check` and imports all succeed; the model load fails at `Tokenizer._flush_specials` with `OverflowError: Python int too large to convert to C ssize_t`.\\n\\n[Failing job with full trace](https://github.com/link-foundation/sensitive-data-sanitizer/actions/runs/42134972915/job/127620684981). The model is the official 3.8.0 wheel with SHA256 `1932429db727d4bff3deed6b34cfc05df17794f4a52eeb26cf8928f7c1a0fb85`.\\n\\nMinimal runtime reproduction after installing those versions:\\n\\n```python\\nimport spacy\\nspacy.load(\\\"en_core_web_sm\\\")\\n```\\n\\nOur downstream workaround is the current Python 3.14 security release (3.14.10), while preserving the latest Presidio and spaCy releases and their declared dependency constraints. We keep an actual scanner/model-load smoke test in CI rather than treating import success as runtime compatibility. Reproducer: `experiments/issue-102/spacy-load.py` in [PR 103](https://github.com/link-foundation/sensitive-data-sanitizer/pull/103).\\n\\nSuggested dependency change: replace the unconditional `preshed\\u003c3.0.14` cap with an exclusion of the broken release (`preshed!=3.0.14,\\u003c3.1` with the appropriate supported lower floor), and verify model loading on 3.14 and 3.15 with 3.0.15. That would let consumers take the fixed wheel without overriding Presidio's metadata. This comment confirms the failing combination; we have not independently tested the 3.0.15 override and are not shipping an incompatible override locally.\\n\",\"html_url\":\"https://github.com/data-privacy-stack/presidio/issues/2431#issuecomment-6673100519\"}\n1681395712\n","exit_code":0,"status":"completed"}}
