ios\",\n    \"mobile:ios:open\": \"cap open ios\",\n    \"mobile:ios:run\": \"npm run build && cap sync ios && cap run ios\",\n    \"mobile:ios:build\": \"npm run build && cap sync ios && cap build ios\"\n  },\n  \"dependencies\": {\n    \"@capacitor/android\": \"^8.6.2\",\n    \"@capacitor/core\": \"^8.6.2\",\n    \"@capacitor/ios\": \"^8.6.2\",\n    \"react\": \"^19.3.1\",\n    \"react-dom\": \"^19.3.1\"\n  },\n  \"devDependencies\": {\n    \"@capacitor/cli\": \"^8.6.2\",\n    \"@vitejs/plugin-react\": \"^6.3.0\",\n    \"electron\": \"^45.4.1\",\n    \"electron-builder\": \"^26.18.0\",\n    \"vite\": \"^8.3.8\"\n  },\n  \"build\": {\n    \"appId\": \"foundation.link.template.example\",\n    \"productName\": \"Universal Example App\",\n    \"asar\": true,\n    \"directories\": {\n      \"output\": \"out\"\n    },\n    \"files\": [\n      \"dist/**/*\",\n      \"electron/**/*\",\n      \"package.json\"\n    ],\n    \"linux\": {\n      \"target\": [\n        \"AppImage\",\n        \"deb\",\n        \"rpm\"\n      ],\n      \"maintainer\": \"Template Maintainers\"\n    },\n    \"mac\": {\n      \"target\": \"zip\"\n    },\n    \"win\": {\n      \"target\": \"nsis\"\n    }\n  },\n  \"allowScripts\": {\n    \"electron-winstaller@5.4.4\": true,\n    \"fsevents@2.3.3\": true\n  },\n  \"overrides\": {\n    \"global-agent\": \"^4.1.7\",\n    \"@electron/asar\": \"4.3.2\",\n    \"temp\": {\n      \"rimraf\": \"file:../../compat/temp-rimraf\"\n    },\n    \"electron-winstaller\": \"5.4.4\",\n    \"minimatch@>=7 <11\": \"^11.0.9\",\n    \"glob@>=9 <14\": \"^14.0.6\"\n  },\n  \"author\": \"Link Foundation\"\n}\nCOMPLETED\nRelated pin in the same release: `presidio-analyzer` 2.2.366 also requires `numpy<2.5.0`.\n\n`numpy` 2.4.6 has no cp315 wheel, so on Python 3.15 that cap forces a source build of numpy too, which means a C toolchain in every downstream image. `numpy` 2.5.x ships the wheel, and the packages around it here accept it (`numba` 0.68 all\n\nConfirmed in an actual Ubuntu 24.04 CI run with the current released graph: CPython 3.15.0, presidio-analyzer 2.2.366, spaCy 3.8.18, preshed 3.0.13 and en_core_web_sm 3.8.0. Package installation, `uv pip check` and imports all succeed; the \n\n[Failing job with full trace](https://github.com/link-foundation/sensitive-data-sanitizer/actions/runs/42134972915/job/127620684981). The model is the official 3.8.0 wheel with SHA256 `1932429db727d4bff3deed6b34cfc05df17794f4a52eeb26cf8928f\n\nMinimal runtime reproduction after installing those versions:\n\n```python\nimport spacy\nspacy.load(\"en_core_web_sm\")\n```\n\nOur downstream workaround is the current Python 3.14 security release (3.14.10), while preserving the latest Presidio and spaCy releases and their declared dependency constraints. We keep an actual scanner/model-load smoke test in CI rather\n\nSuggested dependency change: replace the unconditional `preshed<3.0.14` cap with an exclusion of the broken release (`preshed!=3.0.14,<3.1` with the appropriate supported lower floor), and verify model loading on 3.14 and 3.15 with 3.0.15. \n\n","exit_code":0,"status":"completed"}}
