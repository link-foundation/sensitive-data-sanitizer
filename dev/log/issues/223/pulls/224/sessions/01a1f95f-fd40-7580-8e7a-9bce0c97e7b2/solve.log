e])),\n                latest=info[\"version\"],\n                resolved=\"removed\",\n                location=\"deno.lock\",\n                reason=\"Fresh graph no longer requires this transitive package\",\n                registry=info[\"source\"],\n            )\n        )\n    write_table(\"deno\", rows)\n\n\ndef python_table():\n    registry = json.loads((RESEARCH / \"python-registry.json\").read_text())\n    old = dict(\n        re.findall(\n            r\"^([\\w.-]+)==([^\\s]+)\",\n            before(\"experiments/benchmark/requirements.txt\"),\n            re.M,\n        )\n    )\n    current = dict(\n        re.findall(\n            r\"^([\\w.-]+)==([^\\s]+)\",\n            (ROOT / \"experiments/benchmark/requirements.lock\").read_text(),\n            re.M,\n        )\n    )\n    rows = []\n    for name, version in sorted(current.items()):\n        info = registry[name]\n        consumers = []\n        for parent, metadata in registry.items():\n            for requirement in metadata.get(\"requires_dist\") or []:\n                if re.match(rf\"{re.escape(name)}\\b\", requirement, re.I):\n                    consumers.append(f\"{parent}: {requirement}\")\n        reason = (\n            \"Current registry release\"\n            if version == info[\"version\"]\n            else f\"Resolver's upstream version/platform constraints: {'; '.join(consumers)}\"\n        )\n        rows.append(\n            dict(\n                dependency=name,\n                before=old.get(name, \"previously unlocked\"),\n                latest=info[\"version\"],\n                resolved=version,\n                location=\"experiments/benchmark/requirements.lock\",\n                reason=reason,\n                registry=info[\"source\"],\n            )\n        )\n    write_table(\"python-benchmark\", rows)\n\n    rows = []\n    installed = json.loads((RESEARCH / \"python-tooling-installed.json\").read_text())\n    normalized = {\n        re.sub(r\"[-_.]+\", \"-\", name).lower(): metadata\n        for name, metadata in registry.items()\n    }\n    for item in installed:\n        name, version = item[\"name\"], item[\"version\"]\n        info = normalized[re.sub(r\"[-_.]+\", \"-\", name).lower()]\n        reason = \"Current registry release\"\n        if version != info[\"version\"]:\n            reason = \"pip-audit's supported dependency API range; isolated CI tooling is resolved separately from benchmark NLP dependencies\"\n        rows.append(\n            dict(\n                dependency=name,\n                before=\"runner-provided/unlocked\",\n                latest=info[\"version\"],\n                resolved=version,\n\"\"\"Snapshot published dependency metadata without installing dependency trees.\"\"\"\n\nimport concurrent.futures\nimport csv\nimport json\nimport re\nimport subprocess\nimport urllib.parse\nimport urllib.request\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[2]\nOUTPUT = ROOT / \"dev/log/issues/102/pulls/103/research\"\nBASE = \"6889e9373817a664d13bdaa5c51627f8ba773bef\"\nLOCKS = [\n    \"package-lock.json\",\n    \".github/actions/artifact-transport/package-lock.json\",\n    \"examples/universal-app/package-lock.json\",\n]\n\n\ndef baseline(path):\n    return subprocess.check_output(\n        [\"git\", \"show\", f\"{BASE}:{path}\"], cwd=ROOT, text=True\n    )\n\n\ndef get_json(url):\n    request = urllib.request.Request(url, headers={\"User-Agent\": \"issue-102-research\"})\n    with urllib.request.urlopen(request) as response:\n        return json.load(response)\n\n\ndef npm_metadata(name):\n    url = f\"https://registry.npmjs.org/{urllib.parse.quote(name, safe='')}/latest\"\n    data = get_json(url)\n    return name, {\n        key: data[key]\n        for key in (\n            \"name\",\n            \"version\",\n            \"engines\",\n            \"type\",\n            \"exports\",\n            \"deprecated\",\n            \"dependencies\",\n            \"peerDependencies\",\n            \"repository\",\n        )\n        if key in data\n    } | {\"source\": url}\n\n\ndef npm_inventory():\n    records = []\n    names = {\"npm\", \"npm-check-updates\", \"playwright\", \"browser-commander\"}\n    for path in LOCKS:\n        packages = json.loads(baseline(path))[\"packages\"]\n        for location, info in packages.items():\n            if \"node_modules/\" not in location or info.get(\"link\"):\n                continue\n            name = info.get(\"name\") or location.rsplit(\"node_modules/\", 1)[1]\n            if info.get(\"resolved\", \"\").startswith(\"file:\"):\n                continue\n            names.add(name)\n            records.append((path, location, name, info.get(\"version\", \"MISSING\")))\n    for path in (ROOT / lock for lock in LOCKS):\n        for location, info in json.loads(path.read_text())[\"packages\"].items():\n            if \"node_modules/\" in location and not info.get(\"link\"):\n                name = info.get(\"name\") or location.rsplit(\"node_modules/\", 1)[1]\n                if not info.get(\"resolved\", \"\").startswith(\"file:\"):\n                    names.add(name)\n    for contents in (baseline(\"deno.lock\"), (ROOT / \"deno.lock\").read_text()):\n        names.update(\n            re.match(r\"^(@[^/]+/[^@]+|[^@]+)@\", key)[1]\n            for key in json.loads(contents).get(\"npm\", {})\n        )\n    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as executor:\n        metadata = dict(executor.map(npm_metadata, sorted(names)))\n    (OUTPUT / \"npm-registry.json\").write_text(json.dumps(metadata, indent=2) + \"\\n\")\n    with (OUTPUT / \"npm-before.csv\").open(\"w\") as stream:\n        writer = csv.writer(stream)\n        writer.writerow([\"lockfile\", \"location\", \"dependency\", \"before\", \"latest\"])\n        for path, location, name, version in records:\n            writer.writerow([path, location, name, version, metadata[name][\"version\"]])\n    print(f\"Queried {len