urn sorted(manifests)\n\n\ndef audit(manifests):\n    status = 0\n    python_version = (\n        (Path(__file__).resolve().parents[1] / \".python-version\").read_text().strip()\n    )\n    with tempfile.TemporaryDirectory(prefix=\"python-audit-\") as directory:\n        for index, manifest in enumerate(manifests):\n            print(f\"Auditing resolved Python dependencies: {manifest}\", flush=True)\n            resolved = str(Path(directory) / f\"resolved-{index}.txt\")\n            lock = Path(manifest).with_suffix(\".lock\")\n            commands = (\n                []\n                if lock.is_file()\n                else [\n                    [\n                        \"uv\",\n                        \"pip\",\n                        \"compile\",\n                        \"--no-build\",\n                        \"--python-version\",\n                        python_version,\n                        \"--generate-hashes\",\n                        \"--no-annotate\",\n                        \"--quiet\",\n                        manifest,\n                        \"--output-file\",\n                        resolved,\n                    ],\n                ]\n            )\n            commands.append(\n                [\n                    \"pip-audit\",\n                    \"--disable-pip\",\n                    \"--require-hashes\",\n                    \"--progress-spinner\",\n                    \"off\",\n                    \"--requirement\",\n                    str(lock) if lock.is_file() else resolved,\n                ]\n            )\n            for command in commands:\n                if os.environ.get(\"CI_SCRIPTS_DEBUG\") == \"1\":\n                    print(f\"[python-audit] {command!r}\", flush=True)\n                result = subprocess.run(command, check=False)\n                if result.returncode:\n                    print(\n                        f\"::error file={manifest}::Python dependency resolution or audit failed.\",\n                        flush=True,\n                    )\n                    status = 1\n                    break\n    return status\n\n\ndef main():\n    manifests = discover()\n    if not manifests:\n        print(\"No tracked Python requirements files; no Python dependencies to audit.\")\n    return audit(manifests)\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n M deno.lock\n M docs/API.md\n M docs/CONTRIBUTING.md\n M examples/universal-app/package-lock.json\n M examples/universal-app/package.json\n M experiments/benchmark/README.md\n M experiments/benchmark/requirements.lock\n M experiments/benchmark/run.mjs\n M package-lock.json\n M package.json\n M scripts/package-info.mjs\n M scripts/setup-npm.mjs\n M scripts/setup-preview-gh.sh\n M scripts/sync-betterleaks.py\n M src/ner.js\n M src/vendor/betterleaks/provenance.json\n M tests/security-workflow.test.js\n M tests/setup-buildx-resilient.test.js\n M tests/workflow-reliability.test.js\n M tests/workflows-lint.test.js\n?? .changeset/bright-scanners-update.md\n?? dev/log/issues/223/\n","exit_code":0,"status":"completed"}}
