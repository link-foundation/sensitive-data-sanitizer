d. This\n# reruns such runs, at most twice, and only when no job that ran tests failed.\n# A cancelled run is rerun only when a job stalled in its setup, so a run that\n# someone cancelled stays cancelled.\non:\n  # Runs the default branch's code, reads only numeric run IDs from the event,\n  # and never checks out the commit of the run it inspects.\n  workflow_run: # zizmor: ignore[dangerous-triggers]\n    workflows:\n      - Checks and release\n      - Example app\n      - Security\n      - Broken Link Checker\n      - Workflows\n    types: [completed]\n\npermissions:\n  contents: read\n\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  rerun:\n    name: Rerun jobs that never got a runner\n    # Attempts 1 and 2 may be rerun; the script repeats these checks.\n    if: >-\n      (github.event.workflow_run.conclusion == 'failure' ||\n      github.event.workflow_run.conclusion == 'cancelled' ||\n      github.event.workflow_run.conclusion == 'timed_out') &&\n      github.event.workflow_run.run_attempt < 3\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    concurrency:\n      group: rerun-unacquired-${{ github.event.workflow_run.id }}\n      cancel-in-progress: false\n    permissions:\n      actions: write\n      # Reads the timeout annotations of stalled jobs' check runs.\n      checks: read\n      contents: read\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: ./.github/actions/setup-node\n\n      - name: Rerun the run when only runner acquisition or setup failed\n        env:\n          GITHUB_TOKEN: [REDACTED] github.token }}\n        run: node scripts/rerun-unacquired.mjs rerun\n","exit_code":0,"status":"completed"}}
