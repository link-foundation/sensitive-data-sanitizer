[2026-11-20T14:51:16.844Z] [STDOUT] {"type":"item.completed","item":{"id":"item_241","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,72p' scripts/setup-npm.mjs\nsed -n '1,38p' docs/comparison/secrets-detection.md\nsed -n '84,122p' .github/workflows/links.yml\nrg --hidden -n 'noble@|2\\\\.103\\\\.3|20260329|26\\\\.13\\\\.0|12\\\\.2\\\\.2|0\\\\.17\\\\.4|1\\\\.65\\\\.0|3\\\\.99\\\\.8|v1\\\\.10\\\\.0' --glob '\"'!**/*lock*'\"' --glob '\"'!.git/**'\"' --glob '\"'!dev/log/**'\"' --glob '\"'!docs/case-studies/**'\"' --glob '\"'!experiments/issue-*/**'\"' --glob '\"'!**/results.json'\"' | cut -c1-203 | head -85\ngh release list --repo nodejs/node --limit 8\ngh api repos/actions/setup-java/releases/tags/v6.3.0 --jq .body | head -30\"","aggregated_output":"#!/usr/bin/env node\n\nimport { resolve } from 'node:path';\nimport process from 'node:process';\nimport { fileURLToPath } from 'node:url';\nimport semver from 'semver';\n\n/**\n * Keep the reviewed npm release available for OIDC trusted publishing.\n * The workflow normally installs it through the shared setup-node action;\n * these bounded fallback strategies also support older Node.js installations.\n *\n * Uses link-foundation libraries:\n * - Lockfile-installed command-stream and lino-arguments helpers\n * - command-stream: Modern shell command execution with streaming support\n */\n\nexport const NPM_MIN_VERSION = '12.2.3';\nexport const NODE_MIN_VERSION = '22.22.2';\nexport const NPM_TARGET_MAJOR = 12;\nexport const NPM_REGISTRY_METADATA_URL = 'https://registry.npmjs.org/npm';\n\nexport const compareVersions = semver.compare;\n\nexport function isVersionAtLeast(version, minimumVersion) {\n  return semver.gte(version, minimumVersion);\n}\n\nexport function isSupportedNpmVersion(version) {\n  return isVersionAtLeast(version, NPM_MIN_VERSION);\n}\n\nexport function isSupportedNodeVersion(version) {\n  return semver.satisfies(version, '^22.22.2 || ^24.15.0 || >=26.0.0');\n}\n\nexport function selectLatestSupportedNpmRelease(metadata) {\n  const releases = Object.entries(metadata?.versions || {})\n    .filter(([version, release]) => {\n      const parsed = semver.parse(version);\n      return (\n        parsed &&\n        parsed.major === NPM_TARGET_MAJOR &&\n        parsed.prerelease.length === 0 &&\n        isSupportedNpmVersion(version) &&\n        release?.dist?.tarball\n      );\n    })\n    .sort(([leftVersion], [rightVersion]) =>\n      compareVersions(rightVersion, leftVersion)\n    );\n\n  if (releases.length === 0) {\n    throw new Error(\n      `No npm ${NPM_TARGET_MAJOR}.x release found at or above ${NPM_MIN_VERSION}`\n    );\n  }\n\n  const [version, release] = releases[0];\n  return { version, tarballUrl: release.dist.tarball };\n}\n\nasync function fetchNpmRegistryMetadata(fetchFn) {\n  const response = await fetchFn(NPM_REGISTRY_METADATA_URL, {\n    headers: { accept: 'application/json' },\n  });\n\n  if (!response.ok) {\n    throw new Error(\n      `Failed to fetch npm registry metadata: ${response.status} ${response.statusText}`\n    );\n  }\n# Secrets detection\n\n[← Comparison overview](../COMPARISON.md). Sources:\n[open-source secrets research](../case-studies/issue-128/research/open-source-secrets.md)\nand [closed-source research](../case-studies/issue-128/research/closed-source.md)\n(sections 5 and 6). Legend: **Y** supported, **P** partial, **–** absent, **?**\nunverified.\n\n## Tools and rule sets\n\n| Tool                   | Licence          | Version reviewed   | Rules / detectors                                                                                | Status                                 |\n| ---------------------- | ---------------- | ------------------ | ------------------------------------------------------------------------------------------------ | -------------------------------------- |\n| This project           | Unlicense        | 0.20.0             | 51 native + 221 Gitleaks + 203 Betterleaks text rules, Secretlint 13.1.0 recommended preset (27) | Active                                 |\n| Gitleaks               | MIT              | 8.30.1             | 222                                                                                              | Frozen, security fixes only            |\n| Betterleaks            | MIT              | 1.10.0             | 474 on `main`                                                                                    | Active (Gitleaks author)               |\n| TruffleHog             | AGPL-3.0         | 3.99.8             | 800+ detectors, 700+ verifiable                                                                  | Active                                 |\n| Kingfisher             | Apache-2.0       | 2.18.1             | 503                                                                                              | Active (MongoDB)                       |\n| Titus                  | Apache-2.0       | 1.3.0              | 487                                                                                              | Active; replaces archived Nosey Parker |\n| detect-secrets         | Apache-2.0       | 1.5.0 (+ IBM fork) | 26 plugins + filters                                                                             | Maintenance                            |\n| Secretlint             | MIT              | 13.1.0             | 27 in the recommended preset                                                                     | Active; a required engine here         |\n| ripsecrets             | MIT              | 0.1.11             | about 30 patterns + randomness test                                                              | Low activity                           |\n| Trivy                  | Apache-2.0       | 0.76.2             | 106                                                                                              | Active                                 |\n| Talisman               | MIT              | 1.37.0             | detector categories                                                                              | Low activity                           |\n| whispers               | Apache-2.0       | 1.5.3              | rule YAML + structured parsers                                                                   | Archived                               |\n| GitHub secret scanning | closed           | —                  | about 500 provider + 10 generic + AI                                                             | Active                                 |\n| GitGuardian / ggshield | closed / MIT CLI | ggshield 1.56.1    | 500+ (?)                                                                                         | Active; needs an API key               |\n\nThe Betterleaks rules vendored here are the 203 whose ids are not in the\nGitleaks set. They keep their original RE2 patterns, keywords, entropy\nthresholds and secret-only filters; their `tokenRatio` filters, components and\nvalidation are not ported ([provenance](../../src/vendor/betterleaks/provenance.json)).\n\n## Feature matrix\n\n| Feature                                         | This project                           | Gitleaks       | Betterleaks      | TruffleHog | Kingfisher            | Titus | detect-secrets | Secretlint | ripsecrets | Trivy | Talisman | whispers |\n| ----------------------------------------------- | -------------------------------------- | -------------- | ---------------- | ---------- | --------------------- | ----- | -------------- | ---------- | ---------- | ----- | -------- | -------- |\n| Provider-specific rules                         | Y                                      | Y              | Y                | Y          | Y                     | Y     | P              | Y          | P          | Y     | –        | P        |\n| Generic keyword/assignment rules                | Y (labels in 17 languages)             | Y              | Y                | P          | P                     | P     | Y              | P          | Y          | –     | –        | Y        |\n        run: echo \"day=$(date -u +%F)\" >> \"$GITHUB_OUTPUT\"\n\n      # Every run restores; only main pushes save (see \"Save main link\n      # cache\"), so a pull request cannot seed the cache main runs read.\n      - name: Restore link cache\n        id: restore-link-cache\n        uses: actions/cache/restore@v6.1.0\n        with:\n          path: .lycheecache\n          key: cache-lychee-${{ runner.os }}-${{ steps.link-cache.outputs.day }}-${{ github.sha }}\n          restore-keys: cache-lychee-${{ runner.os }}-${{ steps.link-cache.outputs.day }}-\n\n      # A pinned release whose archive must match both the digests below and\n      # the published checksum; downloads retry, link checks do not.\n      - name: Install pinned lychee with download retries\n        run: bash scripts/run-with-budget-warning.sh 60 \"lychee install\" bash scripts/install-lychee.sh\n        env:\n          LYCHEE_VERSION: v0.24.2\n          LYCHEE_SHA256_X86_64: 1f4e0ef7f6554a6ed33dd7ac144fb2e1bbed98598e7af973042fc5cd43951c9a\n          LYCHEE_SHA256_AARCH64: 91a7bd65685da41b90ccb9bc867a3d649a7818042dae04ff405e55a25bddee4c\n\n      - name: Check links with lychee\n        id: lychee\n        env:\n          GITHUB_TOKEN: [REDACTED] secrets.GITHUB_TOKEN }}\n        run: |\n          mkdir -p lychee\n          # Discard a stale report so a CLI error cannot reuse its evidence.\n          rm -f lychee/out.md\n          code=0\n          # Check all Markdown and HTML files, hidden ones included. Excluded:\n          # docs/case-studies and dev/log (research documents and logs that\n          # reference files and issues of other repositories), the Vite source\n          # HTML (its root-relative asset URLs only resolve when served by\n          # Vite) and tests/fixtures (deliberately broken parser input).\n          lychee --mode task --format markdown --output lychee/out.md \\\n            --verbose --no-progress --cache --max-cache-age 1d \\\n            --max-retries 3 --timeout 30 --hidden --extensions md,html \\\n            --exclude-path docs/case-studies --exclude-path dev/log \\\ndocs/COVERAGE.md:382:A finite serial measurement on Linux x64, Node 26.13.0, using the documents\ndocs/COVERAGE.md:623:On Node v26.13.0, Linux x64, five bounded groups, the median warm detector cost\ndocs/COVERAGE.md:641:2,500 generated Russian names on a short text naming none of them (Node v26.13.0,\ndocs/COVERAGE.md:650:`knownOnly: true` on short texts (Node v26.13.0, Linux x64, three listed names\ndocs/comparison/secrets-detection.md:[REDACTED] TruffleHog             | AGPL-3.0         | 3.99.8             | 800+ detectors, 700+ verifiable                                                                 \nscripts/setup-npm.mjs:85:// Known issue: Node.js 22.22.2 on GitHub Actions (ubuntu-24.04 image >= 20260329.72.1)\ntests/setup-npm.test.js:41:    expect(isSupportedNpmVersion('12.2.2')).toBe(false);\ntests/setup-npm.test.js:51:    expect(isSupportedNodeVersion('v26.13.0')).toBe(true);\ntests/setup-npm.test.js:61:        '12.2.2',\ntests/install-reviewed-npm.test.js:108:  `node-dir-npm install --global --prefix ${prefix} npm@12.2.2 ${INSTALL_FLAGS}\\n`;\ntests/install-reviewed-npm.test.js:109:const CONFIGURED_PREFIX_INSTALL = `npm install --global npm@12.2.2 ${INSTALL_FLAGS}\\n`;\ntests/install-reviewed-npm.test.js:117:        const result = runner.run(['12.2.2']);\ntests/install-reviewed-npm.test.js:124:          'npm 12.2.2 is in effect for top-level and nested npm commands.'\ntests/install-reviewed-npm.test.js:137:        const result = runner.run(['12.2.2']);\ntests/install-reviewed-npm.test.js:153:        const result = runner.run(['12.2.2'], {\ntests/install-reviewed-npm.test.js:160:          `npm@12.2.2 ${INSTALL_FLAGS.replace('=10000', '=9000')} --loglevel=http\\n`\ntests/install-reviewed-npm.test.js:172:      const runner = makeRunner({ configured: