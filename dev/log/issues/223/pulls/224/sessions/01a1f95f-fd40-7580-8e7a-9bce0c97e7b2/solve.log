:\n      default-days: 7\n    groups:\n      benchmark:\n        patterns: ['*']\nimport concurrent.futures\nimport json\nimport pathlib\nimport re\nimport subprocess\nimport sys\nimport urllib.error\nimport urllib.parse\nimport urllib.request\n\nCACHE = pathlib.Path(\"/tmp/sds-224-cache\")\nLOCKS = [\"package-lock.json\", \"examples/universal-app/package-lock.json\", \".github/actions/artifact-transport/package-lock.json\"]\nPY_LOCKS = [\"experiments/benchmark/requirements.lock\", \"dev/log/issues/102/pulls/103/research/requirements-python314.txt\"]\nTOOLS = [\"pip\", \"uv\", \"pip-audit\", \"ruff\", \"shellcheck-py\", \"zizmor\"]\nACTION_REPOS = [\"rhysd/actionlint\", \"zizmorcore/zizmor\", \"jqlang/jq\", \"astral-sh/uv\", \"docker/buildx\", \"moby/buildkit\", \"oven-sh/bun\", \"denoland/deno\", \"lycheeverse/lychee\", \"cli/cli\", \"gitleaks/gitleaks\", \"betterleaks/betterleaks\", \"trufflesecurity/trufflehog\", \"adoptium/temurin21-binaries\", \"adoptium/temurin27-binaries\"]\n\ndef git_file(name):\n    return subprocess.check_output([\"git\", \"show\", \"origin/main:\" + name], text=True)\n\ndef npm_names():\n    names = {\"npm\", \"npm-check-updates\"}\n    for lock in LOCKS:\n        for path, entry in json.loads(git_file(lock))[\"packages\"].items():\n            if \"node_modules/\" in path and \"resolved\" in entry and entry[\"resolved\"].startswith(\"https://registry.npmjs.org/\"):\n                names.add(entry.get(\"name\") or path.rsplit(\"node_modules/\", 1)[1])\n    names.update(re.split(r\"@(?=\\d)\", key)[0] for key in json.loads(git_file(\"deno.lock\"))[\"npm\"])\n    return names\n\ndef pypi_names():\n    return set(TOOLS).union(*(re.findall(r\"^([a-z0-9_-]+)==\", git_file(p), re.M) for p in PY_LOCKS))\n\ndef action_repos():\n    names = set(ACTION_REPOS)\n    paths = subprocess.check_output([\"git\", \"ls-files\", \".github/\"], text=True).splitlines()\n    for name in paths:\n        if not name.endswith((\".yml\", \".yaml\")):\n            continue\n        names.update(\"/\".join(ref.split(\"/\")[:2]) for ref in re.findall(r\"^\\s*(?:- )?uses: ([\\w.-]+/[\\w./-]+)@\", git_file(name), re.M))\n    return names\n\ndef get_json(url):\n    request = urllib.request.Request(url, headers={\"Accept\": \"application/json\", \"User-Agent\": \"sds-dependency-inventory\"})\n    with urllib.request.urlopen(request, timeout=25) as response:\n        return json.load(response)\n\ndef query(mode, name):\n    if mode == \"npm\":\n        url = \"https://registry.npmjs.org/\" + urllib.parse.quote(name, safe=\"@\") + \"/latest\"\n        data = get_json(url)\n        return name, {k: data[k] for k in [\"version\", \"engines\", \"dependencies\", \"optionalDependencies\", \"peerDependencies\", \"deprecated\", \"repository\"] if k in data}\n    if mode == \"pypi\":\n        url = \"https://pypi.org/pypi/\" + name + \"/json\"\n        data = get_json(url)\n        return name, {k: data[\"info\"][k] for k in [\"version\", \"requires_python\", \"requires_dist\", \"project_urls\"]}\n    data = json.loads(subprocess.check_output([\"gh\", \"api\", f\"repos/{name}/releases/latest\"], text=True, stderr=subprocess.PIPE))\n    return name, {k: data[k] for k in [\"tag_name\", \"html_url\", \"published_at\", \"body\"]}\n\nif __name__ == \"__main__\":\n    mode = sys.argv[1]\n    names = sys.argv[2:] or {\"npm\": npm_names, \"pypi\": pypi_names, \"actions\": action_repos}[mode]()\n    output = CACHE / f\"{mode}.json\"\n    versions = json.loads(output.read_text()) if output.exists() else {}\n    with concurrent.futures.ThreadPoolExecutor(max_workers=8 if mode != \"actions\" else 4) as pool:\n        pending = {pool.submit(query, mode, name): name for name in names if name not in versions}\n        for work in concurrent.futures.as_completed(pending):\n            try:\n                name, data = work.result()\n            except (OSError, subprocess.CalledProcessError, ValueError) as err:\n                print(pending[work], err, fi