[2026-11-20T14:37:28.145Z] [STDOUT] {"type":"item.completed","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"cat src/lino-object.js && sed -n '355,415p' tests/workflow-reliability.test.js && sed -n '1,105p' scripts/audit-python-dependencies.py\"","aggregated_output":"import { Parser } from 'links-notation';\nimport { decode, encode, isCompactNotation } from 'lino-objects-codec';\nimport { failure } from './detection.js';\n\nexport function encodeLinoObject(object) {\n  return `${encode({ obj: serializableTree(object) })}\\n`;\n}\n\n// Reports use optional properties, which were omitted by the JSON writer.\nfunction serializableTree(value) {\n  if (Array.isArray(value)) {\n    return value.map((item) => serializableTree(item ?? null));\n  }\n  if (value && typeof value === 'object') {\n    return Object.fromEntries(\n      Object.entries(value)\n        .filter(([, child]) => child !== undefined)\n        .map(([key, child]) => [key, serializableTree(child)])\n    );\n  }\n  return value;\n}\n\n// Limit nesting before using the object codec's recursive reader. Restrict\n// external files to plain trees so compact object graphs cannot enter policy.\nexport function decodeLinoObject(text, maxBytes) {\n  if (Buffer.byteLength(text) > maxBytes || isCompactNotation(text)) {\n    throw failure('ERR_CONFIG');\n  }\n  new Parser({\n    comments: false,\n    maxDepth: 32,\n    maxInputSize: maxBytes,\n    syntax: false,\n  }).parseGroups(text);\n  const object = decode({ notation: text });\n  if (!object || typeof object !== 'object' || Array.isArray(object)) {\n    throw failure('ERR_CONFIG');\n  }\n  checkPlainTree(object);\n  return object;\n}\n\nfunction checkPlainTree(value) {\n  if (!value || typeof value !== 'object') {\n    if (\n      value === undefined ||\n      (typeof value === 'number' && !Number.isFinite(value))\n    ) {\n      throw failure('ERR_CONFIG');\n    }\n    return;\n  }\n  if (\n    Object.getPrototypeOf(value) !==\n    (Array.isArray(value) ? Array.prototype : Object.prototype)\n  ) {\n    throw failure('ERR_CONFIG');\n  }\n  for (const child of Object.values(value)) {\n    checkPlainTree(child);\n  }\n}\n  it('uploads preview regeneration artifacts when screenshot rendering fails', () => {\n    const exampleAppWorkflow = readWorkflow(\n      '.github/workflows/example-app.yml'\n    );\n    const previewRegenJob = getJobBlock(exampleAppWorkflow, 'preview-regen');\n\n    expect(previewRegenJob).toContain(\n      'name: Upload screenshot failure artifacts'\n    );\n    expect(previewRegenJob).toContain('if: failure()');\n    expect(previewRegenJob).toContain(\n      'uses: ./.github/actions/artifact-transport'\n    );\n    expect(previewRegenJob).toContain(\n      'name: preview-regen-failure-${{ github.run_id }}'\n    );\n    expect(previewRegenJob).toContain('path: docs/screenshots/example-app/');\n    expect(previewRegenJob).not.toContain('web/test-results/');\n    expect(previewRegenJob).not.toContain('web/playwright-report/');\n    expect(previewRegenJob).toContain('retention-days: 7');\n    expect(previewRegenJob).toContain('if-no-files-found: error');\n  });\n\n  it('uses the official Playwright image for preview regeneration with browser downloads disabled', () => {\n    const exampleAppWorkflow = readWorkflow(\n      '.github/workflows/example-app.yml'\n    );\n    const previewRegenJob = getJobBlock(exampleAppWorkflow, 'preview-regen');\n    const imageVersion = previewRegenJob.match(\n      /image:\\s*mcr\\.microsoft\\.com\\/playwright@sha256:[0-9a-f]{64} # v([0-9.]+)-noble/\n    )?.[1];\n    const { devDependencies } = JSON.parse(\n      readFileSync('package.json', 'utf8')\n    );\n\n    expect(previewRegenJob).toContain('container:');\n    expect(imageVersion).toBe('1.65.0');\n    expect(devDependencies.playwright).toBe(imageVersion);\n    expect(previewRegenJob).toContain(\n      'run: bash scripts/run-with-budget-warning.sh 60 \"Dependency install\" npm ci --no-audit --no-fund'\n    );\n    expect(previewRegenJob).toContain(\"PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD: '1'\");\n    expect(previewRegenJob).not.toContain('npx playwright install');\n    expect(previewRegenJob).not.toContain('~/.cache/ms-playwright');\n  });\n});\n\ndescribe('workflow artifact and writer reliability', () => {\n  it('serializes main writers and retries generated pushes after rebasing', () => {\n    const exampleAppWorkflow = readWorkflow(\n      '.github/workflows/example-app.yml'\n    );\n    const releaseWorkflow = readWorkflow('.github/workflows/release.yml');\n    const pushHelper = readWorkflow('scripts/push-main-with-rebase-retry.mjs');\n    const versionAndCommit = readWorkflow('scripts/version-and-commit.mjs');\n    const previewRegenJob = getJobBlock(exampleAppWorkflow, 'preview-regen');\n    const releaseJob = getJobBlock(releaseWorkflow, 'release');\n    const instantReleaseJob = getJobBlock(releaseWorkflow, 'instant-release');\n    const dockerPublishJob = getJobBlock(releaseWorkflow, 'docker-publish');\n    const changesetPrJob = getJobBlock(releaseWorkflow, 'changeset-pr');\n    const pagesDeployJob = getJobBlock(exampleAppWorkflow, 'pages-deploy');\n#!/usr/bin/env python3\n\"\"\"Audit every tracked Python requirements file without installing its packages.\n\nCommitted locks are audited directly. For unlocked manifests uv resolves wheel\nmetadata; --no-build prevents executing package build hooks. pip-audit reads the complete hashed resolution,\nso its own environment (including pip) is not mistaken for project dependencies.\nSet CI_SCRIPTS_DEBUG=1 to print the commands and discovered dependency surfaces.\n\"\"\"\n\nimport os\nimport subprocess\nimport tempfile\nfrom pathlib import Path\n\n\ndef discover():\n    paths = subprocess.check_output([\"git\", \"ls-files\", \"-z\"]).decode().split(\"\\0\")\n    manifests = []\n    for path in filter(None, paths):\n        if path.startswith((\"dev/log/\", \"docs/case-studies/\")):\n            continue\n        name = Path(path).name\n        if name.startswith(\"requirements\") and name.endswith(\".txt\"):\n            manifests.append(path)\n        elif name in {\n            \"pyproject.toml\",\n            \"Pipfile\",\n            \"Pipfile.lock\",\n            \"setup.py\",\n            \"setup.cfg\",\n        }:\n            raise ValueError(f\"Unmapped Python dependency manifest: {path}\")\n    return sorted(manifests)\n\n\ndef audit(manifests):\n    status = 0\n    python_version = (\n        (Path(__file__).resolve().parents[1] / \".python-version\").read_text().strip()\n    )\n    with tempfile.TemporaryDirectory(prefix=\"python-audit-\") as directory:\n        for index, manifest in enumerate(manifests):\n            print(f\"Auditing resolved Python dependencies: {manifest}\", flush=True)\n            resolved = str(Path(directory) / f\"resolved-{index}.txt\")\n            lock = Path(manifest).with_suffix(\".lock\")\n            commands = (\n                []\n                if lock.is_file()\n                else [\n                    [\n                        \"uv\",\n                        \"pip\",\n                        \"compile\",\n                        \"--no-build\",\n                        \"--python-version\",\n                        python_version,\n                        \"--generate-hashes\",\n                        \"--no-annotate\",\n                        \"--quiet\",\n                        manifest,\n                        \"--output-file\",\n                        resolved,\n                    ],\n                ]\n            )\n            commands.append(\n                [\n                    \"pip-audit\",\n                    \"--disable-pip\",\n                    \"--require-hashes\",\n                    \"--progress-spinner\",\n                    \"off\",\n                    \"--requirement\",\n                    str(lock) if lock.is_file() else resolved,\n                ]\n            )\n            for command in commands:\n                if os.environ.get(\"CI_SCRIPTS_DEBUG\") == \"1\":\n                    print(f\"[python-audit] {command!r}\", flush=True)\n                result = subprocess.run(command, check=False)\n                if result.returncode:\n                    print(\n                        f\"::error file={manifest}::Python dependency resolution or audit failed.\",\n                        flush=True,\n                    )\n                    status = 1\n                    break\n    return status\n\n\ndef main():\n    manifests = discover()\n    if not manifests:\n        print(\"No tracked Python requirements files; no Python dependencies to audit.\")\n    return audit(manifests)\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
