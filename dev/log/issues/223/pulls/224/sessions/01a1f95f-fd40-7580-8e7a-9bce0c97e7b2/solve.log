 in the repository.\n# Every job starts read-only; the publishing jobs escalate individually.\npermissions:\n  contents: read\n\n# Provide Git config to actions/checkout itself; checkout runs git init before\n# any workflow step can configure Git.\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  # === DETECT CHANGES - determines which jobs should run ===\n  detect-changes:\n    name: Detect Changes\n    runs-on: ubuntu-24.04\n    # Typical run: ~6s. Cap at 5min so a hung detection step\n    # surfaces quickly instead of stalling the whole pipeline.\n    timeout-minutes: 5\n    # Job-level permissions replace the workflow defaults for this job.\n    permissions:\n      contents: read\n      # The detector asks the Actions API whether the previous head of the\n      # branch already passed this workflow, so a docs-only push can trust\n      # its incremental range.\n      actions: read\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-detect-changes\n      cancel-in-progress: true\n    if: github.event_name != 'workflow_dispatch'\n    outputs:\n      js-changed: ${{ steps.changes.outputs.js-changed }}\n      docs-changed: ${{ steps.changes.outputs.docs-changed }}\n      any-code-changed: ${{ steps.changes.outputs.any-code-changed }}\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Detect changes\n        id: changes\n        env:\n          GITHUB_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          GITHUB_BEFORE_SHA: ${{ github.event.before }}\n          GITHUB_AFTER_SHA: ${{ github.event.after }}\n          GITHUB_TOKEN: [REDACTED] secrets.GITHUB_TOKEN }}\n          GITHUB_WORKFLOW_REF: ${{ github.workflow_ref }}\n        run: node scripts/detect-code-changes.mjs\n\n  # === FAST CHECKS - run before slow tests for fastest feedback ===\n  # See: hive-mind CI/CD best practices principle #5 (fast-fail job ordering)\n\n  # Syntax check all .mjs files with node --check (~7s)\n  test-compilation:\n    name: Test Compilation\n    runs-on: ubuntu-24.04\n    # Typical run: <10s. Tight cap fails fast on syntax-check hangs.\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-test-compilation\n      cancel-in-progress: true\n    needs: [detect-changes]\n    if: |\n      !cancelled() &&\n      (needs.detect-changes.outputs.js-changed == 'true' || github.event_name == 'workflow_dispatch')\n    steps:\n      - uses: actions/checkout@v7.0.1\n        with:\n{\"body\":\"## What’s changed\\r\\n\\r\\n## Breaking changes\\r\\n\\r\\n- esm: node v18+ required @ctalkington (#790)\\r\\n\\r\\n## Maintenance\\r\\n\\r\\n- Update actions/checkout action to v4.1.6 @[renovate[bot]](https://github.com/apps/renovate) (#758)\\r\\n- Update actions/checkout action to v4.1.7 @[renovate[bot]](https://github.com/apps/renovate) (#767)\\r\\n- Update actions/setup-node action to v4.0.3 @[renovate[bot]](https://github.com/apps/renovate) (#775)\\r\\n- Update actions/checkout action to v4.2.1 @[renovate[bot]](https://github.com/apps/renovate) (#786)\\r\\n- Update actions/setup-node action to v4.0.4 @[renovate[bot]](https://github.com/apps/renovate) (#784)\\r\\n- Update actions/setup-node action to v4.2.0 @[renovate[bot]](https://github.com/apps/renovate) (#797)\\r\\n- Update actions/checkout action to v4.2.2 @[renovate[bot]](https://github.com/apps/renovate) (#796)\\r\\n- Update release-drafter/release-drafter action to v6.1.0 @[renovate[bot]](https://github.com/apps/renovate) (#805)\\r\\n- Update actions/setup-node action to v4.4.0 @[renovate[bot]](https://github.com/apps/renovate) (#811)\\r\\n- Update release-drafter/release-drafter action to v6.4.0 @[renovate[bot]](https://github.com/apps/renovate) (#825)\\r\\n- Update actions/checkout action to v4.3.1 @[renovate[bot]](https://github.com/apps/renovate) (#826)\\r\\n- Update 