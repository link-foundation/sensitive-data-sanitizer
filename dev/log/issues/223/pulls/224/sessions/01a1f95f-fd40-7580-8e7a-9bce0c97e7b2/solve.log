nal lockfile paths used by the cache\n  registry-url:\n    description: Optional registry for publishing authentication\nruns:\n  using: composite\n  steps:\n    - uses: actions/setup-node@v7.1.0\n      with:\n        node-version-file: .nvmrc\n        # Cache discovery runs npm before setup-node returns. The bundled\n        # npm cannot satisfy devEngines yet (actions/setup-node#1553).\n        package-manager-cache: false\n        registry-url: ${{ inputs.registry-url }}\n    # setup-node selects Node's bundled npm, which currently predates npm 12.\n    # npm ships its own bundled dependency tree; this exact reviewed release\n    # also disables lifecycle scripts. Keep this exception on this install only.\n    # The script also replaces the copy next to node, which nested\n    # `npm --prefix DIR` scripts fall back to on Windows (issue #208), and\n    # verifies both. A registry stall fails under its own name instead of\n    # running into the job's timeout-minutes.\n    - name: Install reviewed npm\n      shell: bash\n      run: bash scripts/run-with-budget-warning.sh 120 \"Reviewed npm install\" bash scripts/install-reviewed-npm.sh 12.2.3\n    # Off by default. A \"Re-run with debug logging\" (runner.debug) lists every\n    # registry request, so an install that stalls shows what it waited on.\n    - name: Enable npm debug logging\n      if: runner.debug == '1'\n      shell: bash\n      run: echo \"NPM_CONFIG_LOGLEVEL=http\" >> \"$GITHUB_ENV\"\n    - name: Restore requested package cache with current npm\n      if: inputs.cache != ''\n      uses: actions/setup-node@v7.1.0\n      with:\n        node-version-file: .nvmrc\n        cache: ${{ inputs.cache }}\n        cache-dependency-path: ${{ inputs.cache-dependency-path }}\n","exit_code":0,"status":"completed"}}
