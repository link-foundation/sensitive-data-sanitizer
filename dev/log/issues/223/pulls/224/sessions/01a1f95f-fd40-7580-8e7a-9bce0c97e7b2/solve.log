\\")} {constraint}')\n                        break\n                    if not parent:\n                        break\n                    parent = parent.rsplit('/node_modules/',1)[0] if '/node_modules/' in parent else ''\n    return incoming\n\nfor name, filename in [('npm-root','package-lock.json'), ('npm-app','examples/universal-app/package-lock.json'), ('npm-artifact','.github/actions/artifact-transport/package-lock.json')]:\n    original = json.loads(before(filename))['packages']\n    current = json.loads(Path(filename).read_text())['packages']\n    parents = npm_consumers(current)\n    rows = []\n    for location in sorted(original.keys() | current.keys()):\n        if 'node_modules/' not in location or current.get(location, original.get(location)).get('link'):\n            continue\n        package = npm_name(location, current.get(location, original.get(location)))\n        old = original.get(location,{}).get('version','')\n        version = current.get(location,{}).get('version','')\n        if package not in npm:\n            assert current.get(location, original.get(location)).get('resolved', '').startswith('file:'), package\n            rows.append((package,old,'local only',version,location,'temp 0.9.4 expects rimraf callbacks. The local adapter delegates to node:fs.rm.','https://github.com/bruce/node-temp/issues/100'))\n            continue\n        latest = npm[package]['version']\n        if not version:\n            reason = 'Location removed or hoisted by the new resolution.'\n        elif latest == version:\n            reason = 'Current.'\n        elif package in nlp_names:\n            reason = 'Current stable 4.x family. npm latest points to an alpha release.'\n        else:\n            assert parents[location], (location, package, version, latest)\n            reason = 'Upstream consumer range: ' + '; '.join(sorted(parents[location]))\n        rows.append((package,old,latest,version,location,reason,npm_url(package)))\n    table(name, sorted(rows))\n\ndef deno_split(key):\n    return re.match(r'\"'^(@[''^/]+/[''^@]+|[''^@]+)@([''^_]+)'\"',key).groups()\n\nold = json.loads(before('deno.lock'))['npm']\ndeno_lock = json.loads(Path('deno.lock').read_text())\nnew = deno_lock['npm']\nold_versions = defaultdict(set)\ncurrent_keys = defaultdict(set)\ncurrent_base_keys = defaultdict(set)\nfor loc in old:\n    package, version = deno_split(loc)\n    old_versions[package].add(version)\nfor loc in new:\n    package, version = deno_split(loc)\n    current_keys[package].add(loc)\n    current_base_keys[f'{package}@{version}'].add(loc)\ndeno_parents = defaultdict(set)\nfor loc, data in new.items():\n    for dep in data.get('dependencies', []) + data.get('optionalDependencies', []):\n        for target in ({dep} if dep in new else current_keys[dep] | current_base_keys[dep]):\n            deno_parents[target].add(loc)\nfor dep, selected in deno_lock['specifiers'].items():\n    if not dep.startswith('npm:'):\n        continue\n    package = re.match(r'\"'^npm:(@[''^/]+/[''^@]+|[''^@]+)'\"',dep)[1]\n    for loc in current_base_keys[f'{package}@{selected.split(\\\"_\\\")[0]}']:\n        deno_parents[loc].add(dep)\nrows = []\nfor loc in sorted(new):\n    package, version = deno_split(loc)\n    latest = npm[package]['version']\n    if latest == version:\n        reason = 'Current.'\n    elif package in nlp_names:\n        reason = 'Current stable 4.x family. npm latest points to an alpha release.'\n    else:\n        reason = 'Consumer resolution in the frozen graph: ' + '; '.join(sorted(deno_parents[loc]))\n    rows.append((package, '; '.join(sorted(old_versions[package])), latest, version, loc, reason, npm_url(package)))\nfor package in old_versions.keys() - current_keys.keys():\n    rows.append((package, '; '.join(sorted(old_versions[package])),npm[package]['version'],'','deno.lock','Fresh graph removed this transitive package.',npm_url(package)))\ntable('deno',sorted(rows))\n\ndef py_versions(contents):\n    return dict(re.findall(r'\"'^([a-z0-9_.-]+)==([''^'\"\\\\s]+)',contents,re.M))\ndef normalize(name):\n    return re.sub(r'[-._]+','-',name.lower())\ndef python_row(name, prev, selected, filename):\n    latest = pypi[name]['version']\n    constrained = {\n        'numpy': 'Presidio 2.2.366 requires numpy<2.5.0.',\n        'preshed': 'Presidio 2.2.366 requires preshed<3.0.14.',\n        'textblob': 'scrubadub 2.0.1 requires textblob==0.15.3.',\n    }\n    if not selected:\n        reason = 'New resolution removed this transitive package.'\n    elif selected == latest:\n        reason = 'Current.'\n    else:\n        reason = constrained.get(name)\n        if reason is None:\n            reason = '; '.join(\n                f'{parent} {requirement}' for parent, data in pypi.items()\n                for requirement in (data['requires_dist'] or [])\n                if normalize(re.match(r'[A-Za-z0-9_.-]+',requirement)[0]) == normalize(name)\n                and 'extra ==' not in requirement)\n        assert reason, (name, selected, latest)\n    return (name,prev,latest,selected,filename,reason,f'https://pypi.org/pypi/{name}/json')\n\nrows = []\nfor filename in ['experiments/benchmark/requirements.txt','experiments/benchmark/requirements.lock','dev/log/issues/102/pulls/103/research/requirements-python314.txt']:\n    old = py_versions(before(filename))\n    new = py_versions(Path(filename).read_text())\n    for name in sorted(old.keys() | new.keys()):\n        rows.append(python_row(name,old.get(name,''),new.get(name,''),filename))\ninstalled = json.loads((cache / 'python-tooling-installed.json').read_text())\nprior = {row['dependency']:row['resolved'] for row in csv.DictReader(Path('dev/log/issues/102/pulls/103/dependencies/python-tooling.csv').open())}\ncurrent_pins = {'ruff':'0.17.4','zizmor':'1.32.0','pip-audit':'2.10.1','shellcheck-py':'0.11.0.1'}\nfor item in installed:\n    name = item['name']\n    key = next(valid for valid in pypi if normalize(valid)==normalize(name))\n    rows.append(python_row(key,current_pins.get(name,prior.get(name,'runner resolved')),item['version'],'isolated tooling environment (not a project lock)'))\nrows.append(python_row('uv','0.13.7','0.13.9','.github/workflows/security.yml'))\nrows.append(python_row('git-filter-repo','2.47.0','2.47.0','.github/workflows/release.yml'))\ntable('python',sorted(rows))\n\naction = re.compile(r'\"'^'\"\\\\s*(?:- )?uses: ([\"'^'\"\\\\s]+)(?:\\\\s+#\\\\s*(v[0-9.]+))?')\ndef action_versions(contents):\n    result = []\n    for num, line in enumerate(contents.splitlines(),1):\n        ref = action.match(line)\n        if ref:\n            spec, tag = ref.groups()\n            result.append((num,*spec.split('@',1),tag) if '@' in spec else (num,spec,'',tag))\n    return result\nrows = []\nfor filename in subprocess.check_output(['git','ls-files','.github'],text=True).splitlines():\n    if not filename.endswith(('.yml','.yaml')):\n        continue\n    seen = defaultdict(list)\n    for _, name, pinned, tag in action_versions(before(filename)):\n        seen[name].append((pinned,tag))\n    for number, name, pinned, tag in action_versions(Path(filename).read_text()):\n        old, old_tag = seen[name].pop(0) if seen[name] else ('','')\n        previous = f'{old} ({old_tag})' if old_tag else old\n        selected = f'{pinned} ({tag})' if tag else pinned\n        repo = '/'.join(name.split('/')[:2])\n        if name.startswith('docker://'):\n            repo = 'rhysd/actionlint'\n        if name.startswith('./'):\n            row = (name,'same branch','same branch','same branch',f'{filename}:{number}','Repository-local composite; versioned with the code.', name)\n        else:\n            latest = actions[repo]['tag_name'] if repo \"'!= '\"'github/codeql-action' else 'v4.39.4'\n            source = actions[repo]['html_url'] if repo \"'!= '\"'github/codeql-action' else 'https://github.com/github/codeql-action/releases/tag/v4.39.4'\n            assert (tag or pinned) == latest, (name, pinned, tag, latest)\n            row = (name,previous,latest,selected,f'{filename}:{number}','Current.',source)\n        rows.append(row)\ntable('github-actions',sorted(rows))\nPY\npython3 /tmp/sds-224-cache/tables.py\nfor f in dev/log/issues/223/pulls/224/*.csv; do wc -l \\\"\"'$f\"; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
