ed: false,\n      errors,\n    };\n  }\n\n  if (!contextExists) {\n    errors.push(`Docker context does not exist: ${context}`);\n  }\n\n  return {\n    context,\n    dockerfile,\n    enabled: errors.length === 0,\n    errors,\n  };\n}\n\nfunction setOutput(name, value) {\n  const outputFile = process.env.GITHUB_OUTPUT;\n  if (outputFile) {\n    appendFileSync(outputFile, `${name}=${value}\\n`);\n  }\n  console.log(`Output: ${name}=${value}`);\n}\n\nfunction isCliEntryPoint() {\n  return (\n    typeof process !== 'undefined' &&\n    process.argv?.[1] &&\n    fileURLToPath(import.meta.url) === path.resolve(process.argv[1])\n  );\n}\n\nexport function main({ env = process.env, stderr = console.error } = {}) {\n  const config = evaluateDockerBuildConfig({ env });\n\n  setOutput('enabled', config.enabled ? 'true' : 'false');\n  setOutput('context', config.context);\n  setOutput('dockerfile', config.dockerfile);\n\n  if (config.errors.length > 0) {\n    for (const error of config.errors) {\n      stderr(`::error::${error}`);\n    }\n    return 1;\n  }\n\n  if (!config.enabled) {\n    console.log(\n      `Docker build check is skipped: no Dockerfile at ${config.dockerfile}`\n    );\n    return 0;\n  }\n\n  console.log(`Docker build check is enabled for ${config.dockerfile}`);\n  return 0;\n}\n\nif (isCliEntryPoint()) {\n  process.exitCode = main();\n}\n505:  # Builds the Dockerfile without pushing so a broken image fails the pull\n508:  # which have no registry credentials. Skipped when no Dockerfile exists.\n557:          cache-from: type=gha,scope=docker-image\n558:          cache-to: type=gha,mode=max,scope=docker-image\n923:      image: ${{ steps.docker_config.outputs.image }}\n985:          image: ${{ needs.docker-publish-config.outputs.image }}\n1044:          IMAGE: ${{ needs.docker-publish-config.outputs.image }}\n1054:          docker buildx imagetools create \\\n1061:          IMAGE: ${{ needs.docker-publish-config.outputs.image }}\n1065:            if ! manifes